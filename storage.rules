rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /self-exploration/{academicYear}/{semester}/{periodId}/{studentId}/{allPaths=**} {
      // Students can read/write their own files, teachers and admins can read/write all
      allow read, write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
