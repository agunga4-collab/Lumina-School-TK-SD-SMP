rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserExists() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRole() {
      return currentUserExists() ? currentUser().role : 'GUEST';
    }

    function isActive() {
      return isSignedIn() &&
        currentUserExists() &&
        currentUser().status == 'active';
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email in ['agunga4@gmail.com', 'agunga4@lazuardi.sch.id']) ||
        (currentUserExists() && userRole() == 'SUPER_ADMIN')
      );
    }

    function isTeacher() {
      return isActive() &&
        (userRole() == 'TEACHER' || userRole() == 'HOMEROOM_TEACHER');
    }

    function isJuniorHighTeacher() {
      return isTeacher() && (
        currentUser().unitId == 'JUNIOR_HIGH' || 
        currentUser().unitId == 'ALL' ||
        ('unit' in currentUser() && (currentUser().unit == 'JUNIOR_HIGH' || currentUser().unit == 'ALL'))
      );
    }

    function isSecretaryKindy() {
      return isActive() && userRole() == 'SECRETARY_KINDY' && currentUser().unitId == 'KINDERGARTEN';
    }

    function isKindergartenHeadUnit() {
      return isActive() && (userRole() == 'HEAD_UNIT' || userRole() == 'kindergarten_head') && (currentUser().unitId == 'KINDERGARTEN' || currentUser().unitId == 'ALL' || !('unitId' in currentUser()));
    }

    function isMidtermIdentityUnchanged() {
      return incoming().studentId == existing().studentId &&
             incoming().studentNameSnapshot == existing().studentNameSnapshot &&
             incoming().classId == existing().classId &&
             incoming().classNameSnapshot == existing().classNameSnapshot &&
             incoming().academicYear == existing().academicYear &&
             incoming().semester == existing().semester &&
             incoming().periodKey == existing().periodKey &&
             incoming().startDate == existing().startDate &&
             incoming().endDate == existing().endDate &&
             incoming().unit == existing().unit &&
             incoming().reportType == existing().reportType &&
             incoming().createdAt == existing().createdAt &&
             incoming().createdBy == existing().createdBy;
    }

    function isSecretaryElem() {
      return isActive() && userRole() == 'SECRETARY_ELEM' && currentUser().unitId == 'ELEMENTARY';
    }

    function isElementaryStaff() {
      return isActive() && (
        isAdmin() || (
          userRole() in [
            'TEACHER', 'HOMEROOM_TEACHER', 'HEAD_UNIT', 'PRINCIPAL',
            'VICE_PRINCIPAL', 'COORDINATOR', 'SECRETARY_ELEM', 'COUNSELOR', 'BK_MENTOR'
          ] && (
            !('unitId' in currentUser()) || currentUser().unitId == 'ELEMENTARY' || currentUser().unitId == 'ALL' ||
            ('unit' in currentUser() && (currentUser().unit == 'ELEMENTARY' || currentUser().unit == 'ALL'))
          )
        )
      );
    }

    function isElementaryHeadUnitOrPrincipal() {
      return isActive() && (
        isAdmin() || (
          userRole() in ['HEAD_UNIT', 'PRINCIPAL', 'VICE_PRINCIPAL', 'SUPER_ADMIN'] && (
            !('unitId' in currentUser()) || currentUser().unitId == 'ELEMENTARY' || currentUser().unitId == 'ALL' ||
            ('unit' in currentUser() && (currentUser().unit == 'ELEMENTARY' || currentUser().unit == 'ALL'))
          )
        )
      );
    }

    function isSecretaryJH() {
      return isActive() && userRole() == 'SECRETARY_JH' && currentUser().unitId == 'JUNIOR_HIGH';
    }

    function isKindergartenClass(classId) {
      return exists(/databases/$(database)/documents/classes/$(classId)) &&
        get(/databases/$(database)/documents/classes/$(classId)).data.unitId == 'KINDERGARTEN';
    }

    function isElementaryClass(classId) {
      return exists(/databases/$(database)/documents/classes/$(classId)) &&
        get(/databases/$(database)/documents/classes/$(classId)).data.unitId == 'ELEMENTARY';
    }

    function isJuniorHighClass(classId) {
      return exists(/databases/$(database)/documents/classes/$(classId)) &&
        get(/databases/$(database)/documents/classes/$(classId)).data.unitId == 'JUNIOR_HIGH';
    }

    function isJuniorHighClassId(classId) {
      return classId is string && (
        classId.matches('JUNIOR_HIGH_.*') || (
          exists(/databases/$(database)/documents/classes/$(classId)) &&
          get(/databases/$(database)/documents/classes/$(classId)).data.unitId == 'JUNIOR_HIGH'
        )
      );
    }

    function isJuniorHighLPUStaff() {
      return isActive() && userRole() in [
        'TEACHER', 'HOMEROOM_TEACHER', 'BK_MENTOR',
        'MTSS_ACADEMIC_PJ', 'COUNSELOR', 'SECRETARY_JH',
        'HEAD_JUNIOR', 'SUPER_ADMIN'
      ];
    }

    function isJuniorHighTeacherOrAuthorizedStaff() {
      return isActive() && isJuniorHighStaff() && (
        !isTeacher() || (currentUser().unitId == 'JUNIOR_HIGH' || currentUser().unitId == 'ALL')
      );
    }

    function isJuniorHighAAPTeacherForClass(classId) {
      return isActive() &&
        isJuniorHighTeacherOrAuthorizedStaff() &&
        isJuniorHighClass(classId);
    }

    function isStudentInClass(studentId, classId) {
      return exists(/databases/$(database)/documents/students/$(studentId)) &&
        get(/databases/$(database)/documents/students/$(studentId)).data.classId == classId;
    }

    function isSecretaryKindyClassAccess(classId) {
      return isSecretaryKindy() && isKindergartenClass(classId);
    }

    function isSecretaryElemClassAccess(classId) {
      return isSecretaryElem() && isElementaryClass(classId);
    }

    function isSecretaryJHClassAccess(classId) {
      return isSecretaryJH() && isJuniorHighClass(classId);
    }

    function isJuniorHighStaff() {
      return isActive() && userRole() in [
        'TEACHER', 'HEAD_JUNIOR', 'BK_MENTOR',
        'MTSS_ACADEMIC_PJ', 'SUPER_ADMIN', 'HEAD_UNIT',
        'PRINCIPAL', 'VICE_PRINCIPAL', 'COORDINATOR',
        'HOMEROOM_TEACHER', 'COUNSELOR', 'SECRETARY_JH'
      ];
    }

    function isJHConferenceStaff() {
      return isActive() && isJuniorHighStaff();
    }

    function isJuniorHighStaffAuthorized() {
      return isActive() && (
        isAdmin() ||
        isJuniorHighTeacher() ||
        (isJuniorHighStaff() && (
          ('unitId' in currentUser() && (currentUser().unitId == 'JUNIOR_HIGH' || currentUser().unitId == 'ALL')) ||
          ('unit' in currentUser() && (currentUser().unit == 'JUNIOR_HIGH' || currentUser().unit == 'ALL'))
        ))
      );
    }

    function isMTSSAcademicManager() {
      return isActive() && userRole() in [
        'HEAD_UNIT', 'HEAD_JUNIOR', 'MTSS_ACADEMIC_PJ', 'SUPER_ADMIN'
      ];
    }

    function isParent() {
      return isActive() && userRole() == 'PARENT';
    }

    function isStudent() {
      return isActive() && userRole() == 'STUDENT';
    }

    function studentClassId() {
      return (currentUserExists() && 'luminaId' in currentUser() && exists(/databases/$(database)/documents/students/$(currentUser().luminaId))) ?
        get(/databases/$(database)/documents/students/$(currentUser().luminaId)).data.classId : '';
    }

    function hasLinkedStudentsField() {
      return currentUserExists() && ('linkedStudents' in currentUser());
    }

    function parentLinkDocExists() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/parentStudentLinks/$(request.auth.token.email.lower()));
    }

    function parentLinkDoc() {
      return request.auth.token.email != null ? get(/databases/$(database)/documents/parentStudentLinks/$(request.auth.token.email.lower())).data : {};
    }

    function getStudentNis() {
      return 'studentId' in currentUser() ? currentUser().studentId : ('luminaId' in currentUser() ? currentUser().luminaId : request.auth.uid);
    }

    function isLinkedStudent(studentId) {
      return isParent() && studentId is string && (
        (
          hasLinkedStudentsField() && (
            studentId in currentUser().linkedStudents ||
            studentId.lower() in currentUser().linkedStudents ||
            studentId.upper() in currentUser().linkedStudents ||
            (currentUser().linkedStudents.size() > 0 && exists(/databases/$(database)/documents/students/$(currentUser().linkedStudents[0])) && 'nisn' in get(/databases/$(database)/documents/students/$(currentUser().linkedStudents[0])).data && get(/databases/$(database)/documents/students/$(currentUser().linkedStudents[0])).data.nisn == studentId) ||
            (currentUser().linkedStudents.size() > 1 && exists(/databases/$(database)/documents/students/$(currentUser().linkedStudents[1])) && 'nisn' in get(/databases/$(database)/documents/students/$(currentUser().linkedStudents[1])).data && get(/databases/$(database)/documents/students/$(currentUser().linkedStudents[1])).data.nisn == studentId) ||
            (currentUser().linkedStudents.size() > 2 && exists(/databases/$(database)/documents/students/$(currentUser().linkedStudents[2])) && 'nisn' in get(/databases/$(database)/documents/students/$(currentUser().linkedStudents[2])).data && get(/databases/$(database)/documents/students/$(currentUser().linkedStudents[2])).data.nisn == studentId)
          )
        ) || (
          parentLinkDocExists() &&
          ('studentIds' in parentLinkDoc()) && (
            studentId in parentLinkDoc().studentIds ||
            studentId.lower() in parentLinkDoc().studentIds ||
            studentId.upper() in parentLinkDoc().studentIds ||
            (parentLinkDoc().studentIds.size() > 0 && exists(/databases/$(database)/documents/students/$(parentLinkDoc().studentIds[0])) && 'nisn' in get(/databases/$(database)/documents/students/$(parentLinkDoc().studentIds[0])).data && get(/databases/$(database)/documents/students/$(parentLinkDoc().studentIds[0])).data.nisn == studentId) ||
            (parentLinkDoc().studentIds.size() > 1 && exists(/databases/$(database)/documents/students/$(parentLinkDoc().studentIds[1])) && 'nisn' in get(/databases/$(database)/documents/students/$(parentLinkDoc().studentIds[1])).data && get(/databases/$(database)/documents/students/$(parentLinkDoc().studentIds[1])).data.nisn == studentId) ||
            (parentLinkDoc().studentIds.size() > 2 && exists(/databases/$(database)/documents/students/$(parentLinkDoc().studentIds[2])) && 'nisn' in get(/databases/$(database)/documents/students/$(parentLinkDoc().studentIds[2])).data && get(/databases/$(database)/documents/students/$(parentLinkDoc().studentIds[2])).data.nisn == studentId)
          )
        )
      );
    }

    function isOwnStudentData(studentId) {
      return isStudent() && studentId is string && currentUserExists() && (
        (request.auth.uid == studentId) ||
        ('luminaId' in currentUser() && currentUser().luminaId == studentId) ||
        ('studentId' in currentUser() && currentUser().studentId == studentId) ||
        (exists(/databases/$(database)/documents/students/$(getStudentNis())) && 
         'nisn' in get(/databases/$(database)/documents/students/$(getStudentNis())).data &&
         get(/databases/$(database)/documents/students/$(getStudentNis())).data.nisn == studentId)
      );
    }

    function isTeacherAssignedToClass(classId) {
      return exists(/databases/$(database)/documents/classes/$(classId)) && (
        get(/databases/$(database)/documents/classes/$(classId)).data.homeroomTeacherId == request.auth.uid ||
        (get(/databases/$(database)/documents/classes/$(classId)).data.homeroomTeacherIds != null && request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.homeroomTeacherIds) ||
        (get(/databases/$(database)/documents/classes/$(classId)).data.waliKelasIds != null && request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.waliKelasIds) ||
        (get(/databases/$(database)/documents/classes/$(classId)).data.assignedTeacherIds != null && request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.assignedTeacherIds) ||
        (get(/databases/$(database)/documents/classes/$(classId)).data.gpkTeacherIds != null && request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.gpkTeacherIds)
      );
    }

    function isClassAssignedToUser(data) {
      return data != null && (
        data.homeroomTeacherId == request.auth.uid ||
        (data.homeroomTeacherIds != null && request.auth.uid in data.homeroomTeacherIds) ||
        (data.waliKelasIds != null && request.auth.uid in data.waliKelasIds) ||
        (data.assignedTeacherIds != null && request.auth.uid in data.assignedTeacherIds) ||
        (data.gpkTeacherIds != null && request.auth.uid in data.gpkTeacherIds)
      );
    }

    function isActiveJuniorHighClassInActiveYear(classId) {
      return exists(/databases/$(database)/documents/classes/$(classId)) &&
        get(/databases/$(database)/documents/classes/$(classId)).data.unitId == 'JUNIOR_HIGH' &&
        get(/databases/$(database)/documents/classes/$(classId)).data.status != 'archived' &&
        get(/databases/$(database)/documents/classes/$(classId)).data.academicYear == get(/databases/$(database)/documents/systemConfig/academicYear).data.activeAcademicYear;
    }

    function isParentBatchValidForCancellation(batchId) {
      return exists(/databases/$(database)/documents/learning_power_up_task_batches/$(batchId)) &&
        get(/databases/$(database)/documents/learning_power_up_task_batches/$(batchId)).data.status in ['PUBLISHED', 'CANCELLED'];
    }

    function isLpuBatchJHList(data) {
      return data.unit == 'JUNIOR_HIGH' || (
        !('unit' in data) && (
          (data.classId != null && data.classId.matches('JUNIOR_HIGH_.*')) ||
          (data.classIds != null && data.classIds.size() > 0) ||
          (data.targetClassIds != null && data.targetClassIds.size() > 0)
        )
      );
    }

    function isLpuBatchJHGet(data) {
      return data.unit == 'JUNIOR_HIGH' || (
        !('unit' in data) && (
          (data.classId != null && data.classId.matches('JUNIOR_HIGH_.*')) ||
          (data.classIds != null && data.classIds.size() > 0 && (
            data.classIds[0].matches('JUNIOR_HIGH_.*') ||
            (data.classIds.size() > 1 && data.classIds[1].matches('JUNIOR_HIGH_.*')) ||
            (data.classIds.size() > 2 && data.classIds[2].matches('JUNIOR_HIGH_.*')) ||
            (data.classIds.size() > 3 && data.classIds[3].matches('JUNIOR_HIGH_.*')) ||
            (data.classIds.size() > 4 && data.classIds[4].matches('JUNIOR_HIGH_.*'))
          )) ||
          (data.targetClassIds != null && data.targetClassIds.size() > 0 && (
            data.targetClassIds[0].matches('JUNIOR_HIGH_.*') ||
            (data.targetClassIds.size() > 1 && data.targetClassIds[1].matches('JUNIOR_HIGH_.*')) ||
            (data.targetClassIds.size() > 2 && data.targetClassIds[2].matches('JUNIOR_HIGH_.*')) ||
            (data.targetClassIds.size() > 3 && data.targetClassIds[3].matches('JUNIOR_HIGH_.*')) ||
            (data.targetClassIds.size() > 4 && data.targetClassIds[4].matches('JUNIOR_HIGH_.*'))
          ))
        )
      );
    }

    function isStudentAllowedBatchGet(data) {
      return data.status == "PUBLISHED" && (
        data.unit == 'JUNIOR_HIGH' || isLpuBatchJHGet(data)
      ) && (
        data.targetClassIds != null && (studentClassId() in data.targetClassIds)
      );
    }

    function isValidLearningPowerUpTaskBatch(data) {
      return data.id != null && data.id != "" &&
             data.subjectKey != null && data.subjectKey != "" &&
             data.subjectArea != null && data.subjectArea != "" &&
             data.academicYearId != null && data.academicYearId != "" &&
             data.semester != null && (data.semester == "1" || data.semester == "2") &&
             data.targetClassIds != null && data.targetClassIds.size() >= 1 &&
             data.weekStartDate != null && data.weekStartDate != "" &&
             data.weekEndDate != null && data.weekEndDate != "" &&
             data.levelTasks != null &&
             data.status != null && data.status in ["DRAFT", "PUBLISHED", "CLOSED", "CANCELLED"] &&
             data.createdBy != null && data.createdBy != "" &&
             data.createdAt != null;
    }

    function isValidLearningPowerUpAssignment(data) {
      return data.id != null && data.id != "" &&
             data.taskBatchId != null && data.taskBatchId != "" &&
             data.studentId != null && data.studentId != "" &&
             data.classId != null && data.classId != "" &&
             data.subjectKey != null && data.subjectKey != "" &&
             data.subjectArea != null && data.subjectArea != "" &&
             data.levelSnapshot != null && data.levelSnapshot != "" &&
             data.taskTitle != null &&
             data.taskInstructions != null &&
             data.academicYearId != null && data.academicYearId != "" &&
             data.semester != null && (data.semester == "1" || data.semester == "2") &&
             data.weekStartDate != null && data.weekStartDate != "" &&
             data.weekEndDate != null && data.weekEndDate != "" &&
             data.status != null && data.status in ["ASSIGNED", "SUBMITTED", "REVISION_REQUIRED", "VERIFIED", "CANCELLED"] &&
             data.history != null &&
             data.updatedAt != null;
    }

    function isValidAAPAssessment(data) {
      return data.studentId != null && data.studentId != "" &&
             data.classId != null && data.classId != "" &&
             data.academicYear != null && data.academicYear != "";
    }

    function isValidAAPFollowupPlan(data) {
      return data.studentId != null && data.studentId != "" &&
             data.classId != null && data.classId != "" &&
             data.academicYear != null && data.academicYear != "";
    }

    function isValidAAPMidtermReview(data) {
      return data.studentId != null && data.studentId != "" &&
             data.classId != null && data.classId != "" &&
             data.academicYearId != null && data.academicYearId != "" &&
             data.termId != null && data.termId != "";
    }

    function isValidAAPEndOfTermReport(data) {
      return data.studentId != null && data.studentId != "" &&
             data.classId != null && data.classId != "" &&
             data.academicYearId != null && data.academicYearId != "" &&
             data.termId != null && data.termId != "";
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidSESubmission(data) {
      return data.overallStatus != 'SUBMITTED' || (
        data.slots != null &&
        data.slots.size() > 0 &&
        data.slots[0].reflectionText is string &&
        data.slots[0].reflectionText.size() >= 80 &&
        (data.gradeSnapshot == 9 || (
          data.slots.size() > 1 &&
          data.slots[1].reflectionText is string &&
          data.slots[1].reflectionText.size() >= 80
        ))
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'status'])
        && data.uid == request.auth.uid
        && (request.auth.token.email == null || data.email.lower() == request.auth.token.email.lower())
        && data.role in [
          'TEACHER', 'HEAD_UNIT', 'HEAD_JUNIOR', 'BK_MENTOR',
          'PARENT', 'STUDENT', 'SUPER_ADMIN', 'GUEST',
          'MTSS_ACADEMIC_PJ', 'PRINCIPAL', 'VICE_PRINCIPAL',
          'COORDINATOR', 'HOMEROOM_TEACHER', 'COUNSELOR',
          'kindergarten_subject_teacher', 'SECRETARY_KINDY',
          'SECRETARY_ELEM', 'SECRETARY_JH'
        ]
        && data.status in ['active', 'pending', 'disabled'];
    }

    function isValidMTSSAcademicCase(data) {
      return data.keys().hasAll(['id', 'studentId', 'status', 'currentTier', 'primaryConcern'])
        && data.id is string
        && data.studentId is string
        && data.status in [
          'SCREENING', 'INITIAL_MEETING', 'ACTIVE',
          'UNDER_REVIEW', 'ESCALATED', 'CLOSED'
        ]
        && data.currentTier in ['Tier 1', 'Tier 2', 'Tier 3'];
    }

    function isValidMTSSAcademicAlert(data) {
      return data.keys().hasAll(['id', 'caseId', 'type', 'severity', 'status'])
        && data.id is string
        && data.caseId is string
        && data.severity in ['INFO', 'WARNING', 'CRITICAL']
        && data.status in ['OPEN', 'ACKNOWLEDGED', 'RESOLVED', 'DISMISSED', 'ARCHIVED'];
    }

    function isValidClassAnecdote(data) {
      return data.keys().hasAll([
        'studentId', 'studentName', 'classId', 'className', 'unit',
        'academicYearId', 'date', 'time', 'activityContext', 'anecdote',
        'followUp', 'createdBy', 'createdAt', 'updatedAt'
      ])
      && data.keys().size() == 14
      && data.studentId is string && data.studentId.size() <= 128
      && data.studentName is string && data.studentName.size() <= 200
      && data.classId is string && data.classId.size() <= 128
      && data.className is string && data.className.size() <= 128
      && data.unit == 'ELEMENTARY'
      && data.academicYearId is string && data.academicYearId.size() <= 32
      && data.date is timestamp
      && data.time is string && data.time.size() <= 32
      && data.activityContext is string && data.activityContext.size() <= 500
      && data.anecdote is string && data.anecdote.size() <= 5000
      && (data.followUp == null || (data.followUp is string && data.followUp.size() <= 2000))
      && data.createdBy is map
      && data.createdBy.uid == request.auth.uid
      && data.createdBy.name is string && data.createdBy.name.size() <= 200
      && data.createdBy.role is string && data.createdBy.role.size() <= 128
      && data.createdAt == request.time
      && data.updatedAt == request.time;
    }

    function isValidClassAnecdoteUpdate(data) {
      return data.keys().hasAll([
        'studentId', 'studentName', 'classId', 'className', 'unit',
        'academicYearId', 'date', 'time', 'activityContext', 'anecdote',
        'followUp', 'createdBy', 'createdAt', 'updatedAt'
      ])
      && data.keys().size() == 14
      && data.studentId is string && data.studentId.size() <= 128
      && data.studentName is string && data.studentName.size() <= 200
      && data.classId is string && data.classId.size() <= 128
      && data.className is string && data.className.size() <= 128
      && data.unit == 'ELEMENTARY'
      && data.academicYearId is string && data.academicYearId.size() <= 32
      && data.date is timestamp
      && data.time is string && data.time.size() <= 32
      && data.activityContext is string && data.activityContext.size() <= 500
      && data.anecdote is string && data.anecdote.size() <= 5000
      && (data.followUp == null || (data.followUp is string && data.followUp.size() <= 2000))
      && data.createdBy is map
      && data.createdBy.uid is string && data.createdBy.uid.size() <= 128
      && data.createdBy.name is string && data.createdBy.name.size() <= 200
      && data.createdBy.role is string && data.createdBy.role.size() <= 128
      && data.createdAt is timestamp
      && data.updatedAt == request.time;
    }

    function isValidTeacherSupportIntervention(data) {
      return data.keys().hasAll([
        'id', 'studentId', 'studentName', 'classId', 'className',
        'academicYear', 'semester', 'issueType', 'incidentIds',
        'interventionPlan', 'status', 'outcomeNote', 'createdBy',
        'createdByName', 'createdAt', 'updatedBy', 'updatedAt',
        'completedBy', 'completedAt'
      ])
      && data.id is string && data.id.size() <= 128
      && data.studentId is string && data.studentId.size() <= 128
      && data.studentName is string && data.studentName.size() <= 200
      && data.classId is string && data.classId.size() <= 128
      && data.className is string && data.className.size() <= 128
      && data.academicYear is string && data.academicYear.size() <= 32
      && (data.semester == null || data.semester is string)
      && data.issueType in ['lateness', 'minor_violation', 'moderate_violation']
      && data.incidentIds is list && data.incidentIds.size() > 0 && data.incidentIds.size() <= 50
      && data.interventionPlan is string && data.interventionPlan.size() <= 2000
      && data.status in ['in_progress', 'completed']
      && (data.outcomeNote == null || (data.outcomeNote is string && data.outcomeNote.size() <= 2000))
      && data.createdBy is string && data.createdBy.size() <= 128
      && (data.createdByName == null || (data.createdByName is string && data.createdByName.size() <= 200))
      && (data.updatedBy == null || (data.updatedBy is string && data.updatedBy.size() <= 128))
      && (data.completedBy == null || (data.completedBy is string && data.completedBy.size() <= 128));
    }

    function isValidModerateViolation(data) {
      return data.keys().hasAll([
        'unit', 'studentId', 'studentName', 'classId', 'className',
        'date', 'incidentType', 'categoryId', 'categoryLabel',
        'violationCode', 'violationLabel', 'recordedByUid', 'recordedByName',
        'academicYear', 'semester', 'createdAt', 'updatedAt'
      ])
      && data.unit == 'JUNIOR_HIGH'
      && data.incidentType == 'moderate_violation'
      && data.categoryId in ['konflik_teman', 'geng', 'pacaran']
      && data.studentId is string && data.studentId.size() <= 128
      && data.studentName is string && data.studentName.size() <= 200
      && data.classId is string && data.classId.size() <= 128
      && data.className is string && data.className.size() <= 128
      && data.date is string && data.date.size() == 10
      && data.violationCode is string && data.violationCode.size() <= 32
      && data.violationLabel is string && data.violationLabel.size() <= 300
      && data.recordedByUid is string && data.recordedByUid.size() <= 128
      && data.recordedByName is string && data.recordedByName.size() <= 200
      && data.academicYear is string && data.academicYear.size() <= 32
      && (data.semester is string || data.semester is int || data.semester is number)
      && (data.notes == null || (data.notes is string && data.notes.size() <= 2000))
      && (data.isCustom == null || data.isCustom is bool)
      && (data.mtssBehaviorCaseId == null || (data.mtssBehaviorCaseId is string && data.mtssBehaviorCaseId.size() <= 128))
      && (data.mtssTier == null || (data.mtssTier is string && data.mtssTier.size() <= 32));
    }

    function isValidClassLearningGoals(data) {
      return data.keys().hasAll([
        'classId', 'academicYear', 'semester', 'midtermPeriodKey',
        'nilaiAgamaBudiPekerti', 'jatiDiri', 'dasarLiterasiSteam',
        'status', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
      ])
      && data.keys().size() >= 12 && data.keys().size() <= 14
      && data.keys().hasOnly([
        'classId', 'academicYear', 'semester', 'midtermPeriodKey',
        'nilaiAgamaBudiPekerti', 'jatiDiri', 'dasarLiterasiSteam',
        'status', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy',
        'signingDate', 'signingLocation'
      ])
      && data.classId is string && data.classId.size() <= 128
      && data.academicYear is string && data.academicYear.size() <= 32
      && (data.semester is int || data.semester is float) && data.semester in [1, 2]
      && data.midtermPeriodKey is string && data.midtermPeriodKey.size() <= 128
      && data.nilaiAgamaBudiPekerti is string && data.nilaiAgamaBudiPekerti.size() <= 50000
      && data.jatiDiri is string && data.jatiDiri.size() <= 50000
      && data.dasarLiterasiSteam is string && data.dasarLiterasiSteam.size() <= 50000
      && data.status is string && data.status in ['DRAFT', 'READY']
      && (data.createdAt is int || data.createdAt is float) && data.createdAt > 0
      && data.createdBy is string && data.createdBy.size() <= 256
      && (data.updatedAt is int || data.updatedAt is float) && data.updatedAt > 0
      && data.updatedBy is string && data.updatedBy.size() <= 256
      && (!('signingDate' in data) || data.signingDate is string)
      && (!('signingLocation' in data) || data.signingLocation is string);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        isTeacher() ||
        isKindergartenHeadUnit() ||
        isSecretaryKindy() ||
        isElementaryStaff() ||
        isJuniorHighStaff()
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        isTeacher() ||
        isKindergartenHeadUnit() ||
        isSecretaryKindy() ||
        isElementaryStaff() ||
        isJuniorHighStaff() ||
        (
          isJHConferenceStaff() &&
          resource.data.status == 'active' &&
          resource.data.role in [
            'TEACHER', 'HOMEROOM_TEACHER', 'BK_MENTOR',
            'HEAD_JUNIOR', 'HEAD_UNIT', 'SUPER_ADMIN'
          ]
        )
      );
      allow create: if isSignedIn() && userId == request.auth.uid && isValidUser(incoming());
      allow update: if isAdmin()
        || (isSignedIn()
          && userId == request.auth.uid
          && incoming().role == existing().role
          && (incoming().status == existing().status || (existing().status == 'ready' && incoming().status == 'active'))
          && isValidUser(incoming()));
    }

    match /onboarding/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && userId == request.auth.uid;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /roleInvites/{inviteId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isSignedIn() && (
        isAdmin() || (
          resource.data.status == 'ready' &&
          request.resource.data.status == 'used'
        )
      );
      allow delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isActive();
      allow write: if isAdmin() || isJuniorHighStaff();
    }

    match /classes/{classId} {
      allow read: if isActive();
      allow create, delete: if isAdmin() || isMTSSAcademicManager();
      allow update: if isAdmin() || isMTSSAcademicManager() || (
        isSignedIn() &&
        existing().homeroomTeacherId is string &&
        existing().homeroomTeacherId.matches('INVITE_.*') &&
        incoming().homeroomTeacherId == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['homeroomTeacherId', 'homeroomTeacherName'])
      );
    }

    match /systemConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /systemSettings/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isActive();
      allow write: if isAdmin() || isMTSSAcademicManager();
    }

    match /behaviorCases/{caseId} {
      allow read: if isActive() && isJuniorHighStaff();
      allow read: if isActive() && isLinkedStudent(existing().studentId);
      allow create: if isJuniorHighStaff() && incoming().keys().hasAll(['studentId', 'status', 'tier']);
      allow update: if isAdmin() || isJuniorHighStaff();
      allow delete: if isAdmin();

      match /concerns/{concernId} {
        allow read: if isActive() && isJuniorHighStaff();
        allow create: if isJuniorHighStaff();
        allow update, delete: if isAdmin() || (isJuniorHighStaff() && existing().reporterId == request.auth.uid);
      }
    }

    match /teacherSupportInterventions/{interventionId} {
      allow read: if isActive() && (isJuniorHighStaff() || isAdmin());
      allow create: if (isJuniorHighStaff() || isAdmin()) && isValidTeacherSupportIntervention(incoming()) && incoming().createdBy == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if (isJuniorHighStaff() || isAdmin()) && isValidTeacherSupportIntervention(incoming()) && incoming().updatedAt == request.time
        && incoming().createdBy == existing().createdBy && incoming().createdAt == existing().createdAt && incoming().studentId == existing().studentId && incoming().issueType == existing().issueType
        && incoming().updatedBy == request.auth.uid
        && (existing().status == 'in_progress' || isAdmin());
      allow delete: if isAdmin();
    }

    match /juniorhigh_mtss_academic_cases/{caseId} {
      allow read: if isActive() && isJuniorHighStaff();
      allow read: if isActive() && isLinkedStudent(existing().studentId);
      allow create: if isJuniorHighStaff() && isValidMTSSAcademicCase(incoming());
      allow update: if isAdmin() || isJuniorHighStaff();
      allow delete: if isAdmin();

      match /goals/{goalId} {
        allow read, write: if isJuniorHighStaff();
      }

      match /sessions/{sessionId} {
        allow read: if isJuniorHighStaff()
          || isLinkedStudent(get(/databases/$(database)/documents/juniorhigh_mtss_academic_cases/$(caseId)).data.studentId);
        allow write: if isJuniorHighStaff();
      }

      match /meetings/{meetingId} {
        allow read, write: if isJuniorHighStaff();
      }

      match /plans/{planId} {
        allow read, write: if isJuniorHighStaff();
      }

      match /evaluations/{evaluationId} {
        allow read: if isJuniorHighStaff()
          || isLinkedStudent(get(/databases/$(database)/documents/juniorhigh_mtss_academic_cases/$(caseId)).data.studentId);
        allow write: if isJuniorHighStaff();
      }

      match /parentDocuments/{docId} {
        allow read: if isJuniorHighStaff()
          || isLinkedStudent(get(/databases/$(database)/documents/juniorhigh_mtss_academic_cases/$(caseId)).data.studentId);
        allow write: if isJuniorHighStaff();
      }

      match /audits/{auditId} {
        allow read, create: if isJuniorHighStaff();
      }
    }

    match /juniorhigh_mtss_academic_alerts/{alertId} {
      allow read: if isJuniorHighStaff();
      allow write: if isJuniorHighStaff() && isValidMTSSAcademicAlert(incoming());
    }

    match /juniorhigh_mtss_academic_timeline/{phaseId} {
      allow read: if isJuniorHighStaff();
      allow write: if isMTSSAcademicManager();
    }

    match /juniorhigh_mtss_academic_documents/{docId} {
      allow read, write: if isJuniorHighStaff();
    }

    match /juniorhigh_mtss_academic_backup_config/{configId} {
      allow read: if isJuniorHighStaff();
      allow write: if isAdmin();
    }

    match /juniorhigh_mtss_tier1_assessments/{assessmentId} {
      allow read, write: if isJuniorHighStaff();
    }

    match /cicoSessions/{sessionId} {
      allow read: if isActive() && isJuniorHighStaff();
      allow read: if isActive() && isLinkedStudent(existing().studentId);
      allow write: if isJuniorHighStaff();
    }

    match /cicoGoalConfigs/{caseId} {
      allow read, write: if isActive() && isJuniorHighStaff();
    }

    match /bipPlans/{planId} {
      allow read: if isActive() && isJuniorHighStaff() && (userRole() in ['BK_MENTOR', 'HEAD_JUNIOR', 'SUPER_ADMIN']);
      allow write: if isAdmin() || (isActive() && userRole() in ['BK_MENTOR', 'HEAD_JUNIOR']);
    }

    match /reflections/{reflectionId} {
      allow read: if isActive() && isJuniorHighStaff();
      allow read: if isActive() && isStudent() && existing().studentId == request.auth.uid;
      allow read: if isActive() && isLinkedStudent(existing().studentId);
      allow create: if isStudent() || isJuniorHighStaff();
      allow update: if isAdmin() || (isStudent() && existing().studentId == request.auth.uid);
    }

    match /literacyProgress/{progressId} {
      allow read: if isActive() && isJuniorHighStaff();
      allow read: if isActive() && isLinkedStudent(existing().studentId);
      allow write: if isJuniorHighStaff();
    }

    match /junior_high_literacy_numeracy_records/{recordId} {
      // Students may query their own canonical level records only.
      allow read: if isActive() && isOwnStudentData(existing().studentId);
      allow read: if isActive() && isJuniorHighStaff();
      allow read: if isActive() && isLinkedStudent(existing().studentId);
      allow write: if isJuniorHighStaff();
    }

    // Litnum session-title metadata only; assessment records are unchanged.
    function litnumSessionTitleYearKey(year) {
      let parts = year.split('/');
      return parts.size() == 2 ? parts[0] + '-' + parts[1] : year;
    }
    function isValidLitnumSessionTitleValue(titles, key) {
      return !(key in titles) || (titles[key] is string && titles[key].size() <= 200);
    }
    function isValidLitnumSessionTitleMetadata(data, titleId) {
      let fields = ['id', 'unit', 'schoolYear', 'classId', 'subjectArea', 'sessionTitles', 'updatedAt'];
      let cls = get(/databases/$(database)/documents/classes/$(data.classId)).data;
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.id == titleId && data.unit == 'JUNIOR_HIGH'
        && data.schoolYear is string && data.schoolYear.matches('[0-9]{4}[-/][0-9]{4}')
        && data.classId is string && data.classId.size() > 0 && data.classId.size() <= 128
        && cls.unitId == 'JUNIOR_HIGH' && cls.academicYear is string
        && litnumSessionTitleYearKey(cls.academicYear) == litnumSessionTitleYearKey(data.schoolYear)
        && data.subjectArea in ['BAHASA_INDONESIA', 'ENGLISH_READING', 'MENGAJI', 'NUMERACY']
        && titleId == data.classId + '_' + data.subjectArea + '_' + litnumSessionTitleYearKey(data.schoolYear)
        && data.sessionTitles is map
        && data.sessionTitles.keys().hasOnly(['SEMESTER_1_START', 'SEMESTER_1_END', 'SEMESTER_2_START', 'SEMESTER_2_END', 'SPRING_ASSESSMENT_3'])
        && isValidLitnumSessionTitleValue(data.sessionTitles, 'SEMESTER_1_START')
        && isValidLitnumSessionTitleValue(data.sessionTitles, 'SEMESTER_1_END')
        && isValidLitnumSessionTitleValue(data.sessionTitles, 'SEMESTER_2_START')
        && isValidLitnumSessionTitleValue(data.sessionTitles, 'SEMESTER_2_END')
        && isValidLitnumSessionTitleValue(data.sessionTitles, 'SPRING_ASSESSMENT_3')
        && data.updatedAt is number && data.updatedAt >= 0;
    }
    match /junior_high_litnum_session_titles/{titleId} {
      // No resource-data check: staff can GET a not-yet-created metadata document.
      allow get, list: if isLpuTrackerReader();
      allow create: if isLpuTrackerWriter() && isValidLitnumSessionTitleMetadata(request.resource.data, titleId);
      allow update: if isLpuTrackerWriter() && isValidLitnumSessionTitleMetadata(request.resource.data, titleId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sessionTitles', 'updatedAt']);
      allow delete: if false;
    }

    match /junior_high_litnum_custom_columns/{columnId} {
      allow read: if isActive() && (isJuniorHighStaff() || isAdmin());
      allow write: if isActive() && (isJuniorHighStaff() || isAdmin());
    }

    match /junior_high_litnum_cell_values/{cellId} {
      allow read: if isActive() && (isJuniorHighStaff() || isAdmin() || isLinkedStudent(existing().studentId) || isOwnStudentData(existing().studentId));
      allow write: if isActive() && (isJuniorHighStaff() || isAdmin());
    }

    // Students may GET only the reference metadata for their own canonical class.
    // No list access and no grade/result access is added here.
    function isOwnLpuClassReferenceId(refId) {
      let classKey = studentClassId();
      let pieces = refId.split('_');
      let yearKey = pieces[pieces.size() - 1];
      return isStudent() && classKey is string && classKey.size() > 0
        && yearKey.matches('[0-9]{4}-[0-9]{4}')
        && refId in [
          classKey + '_BAHASA_INDONESIA_' + yearKey,
          classKey + '_ENGLISH_READING_' + yearKey,
          classKey + '_MENGAJI_' + yearKey,
          classKey + '_NUMERACY_' + yearKey
        ]
        && (resource == null || resource.data.classId == classKey);
    }
    match /lpu_subject_references/{refId} {
      allow get: if isActive() && (isJuniorHighStaff() || isAdmin() || isOwnLpuClassReferenceId(refId));
      allow list: if isActive() && (isJuniorHighStaff() || isAdmin());
      allow write: if isActive() && (isJuniorHighStaff() || isAdmin());
    }

    match /learning_power_up_completion/{completionId} {
      allow read: if isActive() && (isAdmin() || isJuniorHighStaff() || isOwnStudentData(existing().studentId) || isLinkedStudent(existing().studentId));
      allow create, update, delete: if isAdmin() || isJuniorHighLPUStaff();
    }

    match /cicoWeeklyReflections/{reflectionId} {
      allow read: if isActive() && isJuniorHighStaff();
      allow read: if isActive() && isLinkedStudent(existing().studentId);
      allow write: if isJuniorHighStaff();
    }

    match /cicoWeeklyWorksheets/{worksheetId} {
      allow read, write: if isActive() && (isJuniorHighStaffAuthorized() || isJuniorHighStaff());
    }

    match /elementary_mtss_cases/{caseId} {
      allow read: if isActive() && (isTeacher() || isSecretaryElem() || isAdmin() || isJuniorHighStaff() || isLinkedStudent(resource.data.studentId));
      allow write: if isTeacher() || isSecretaryElem() || isAdmin() || isJuniorHighStaff();

      match /coaching_sessions/{sessionId} {
        allow read: if isActive() && (isTeacher() || isSecretaryElem() || isAdmin() || isJuniorHighStaff() || isLinkedStudent(get(/databases/$(database)/documents/elementary_mtss_cases/$(caseId)).data.studentId));
        allow write: if isTeacher() || isSecretaryElem() || isAdmin() || isJuniorHighStaff();
      }
    }

    match /elementary_mtss_batch_sheets/{sheetId} {
      allow read, write: if isActive() && (isTeacher() || isSecretaryElem() || isAdmin() || isJuniorHighStaff());
    }

    match /elementary_literacy_numeracy/{recordId} {
      allow read: if isActive() && (isTeacher() || isSecretaryElemClassAccess(existing().classId) || isAdmin() || isJuniorHighStaff() || isLinkedStudent(existing().studentId));
      allow write: if isTeacher() || isSecretaryElemClassAccess(incoming().classId) || isAdmin() || isJuniorHighStaff();
    }

    match /elementary_literacy_numeracy_records/{recordId} {
      allow read: if isActive() && (isTeacher() || isSecretaryElemClassAccess(existing().classId) || isAdmin() || isJuniorHighStaff() || isLinkedStudent(existing().studentId));
      allow write: if isTeacher() || isSecretaryElemClassAccess(incoming().classId) || isAdmin() || isJuniorHighStaff();
    }

    match /elementaryLiteracyNumeracySheetConfigs/{configId} {
      allow read: if isActive() && (isTeacher() || isSecretaryElem() || isAdmin() || isJuniorHighStaff());
      allow write: if isAdmin();
    }

    match /selfExploration/{studentId} {
      allow read: if isActive() && (
        isOwnStudentData(studentId) ||
        (isStudent() && studentId == request.auth.uid) ||
        isJuniorHighStaff() ||
        isAdmin() ||
        isLinkedStudent(studentId)
      );
      allow write: if isActive() && (
        isAdmin() ||
        isJuniorHighStaff() ||
        (isStudent() && studentId == request.auth.uid) ||
        isOwnStudentData(studentId)
      );

      match /plans/{periodId} {
        allow read: if isActive() && (
          isOwnStudentData(studentId) ||
          (isStudent() && studentId == request.auth.uid) ||
          isJuniorHighStaff() ||
          isAdmin() ||
          isLinkedStudent(studentId)
        );
        allow write: if isActive() && (
          isAdmin() ||
          isJuniorHighStaff() ||
          (isStudent() && studentId == request.auth.uid) ||
          isOwnStudentData(studentId)
        );
      }
    }

    match /seMonthlyReflections/{reflectionId} {
      allow get: if isActive() && (
        resource == null ||
        isOwnStudentData(resource.data.studentId) ||
        isAdmin() ||
        (isJuniorHighStaff() && resource.data.unit == 'JUNIOR_HIGH') ||
        isLinkedStudent(resource.data.studentId)
      );

      allow list: if isActive() && (
        isAdmin() ||
        (isJuniorHighStaff() && resource.data.unit == 'JUNIOR_HIGH')
      );

      allow create: if isActive() && (
        isOwnStudentData(incoming().studentId) &&
        incoming().unit == 'JUNIOR_HIGH' &&
        incoming().overallStatus in ['DRAFT', 'SUBMITTED'] &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        reflectionId.split('_')[0] == incoming().studentId &&
        isValidSESubmission(incoming())
      );

      allow update: if isActive() && (
        (
          isOwnStudentData(existing().studentId) &&
          incoming().studentId == existing().studentId &&
          incoming().unit == 'JUNIOR_HIGH' &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().classId == existing().classId &&
          incoming().academicYear == existing().academicYear &&
          incoming().semester == existing().semester &&
          incoming().periodKey == existing().periodKey &&
          (!('reflectionCycleId' in existing()) || (incoming().reflectionCycleId == existing().reflectionCycleId)) &&
          (!('sePeriodId' in existing()) || (incoming().sePeriodId == existing().sePeriodId)) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['slots', 'overallStatus', 'updatedAt', 'reflectionCycleId', 'sePeriodId']) &&
          existing().overallStatus in ['DRAFT', 'REVISION_REQUESTED'] &&
          incoming().overallStatus in ['DRAFT', 'SUBMITTED'] &&
          (incoming().slots.size() > 0 && (
            existing().slots.size() > 0 && existing().slots[0].status == 'APPROVED' ?
              incoming().slots[0] == existing().slots[0] :
              incoming().slots[0].teacherFeedback == (existing().slots.size() > 0 ? existing().slots[0].teacherFeedback : '') &&
              incoming().slots[0].reviewedBy == (existing().slots.size() > 0 ? existing().slots[0].reviewedBy : null) &&
              incoming().slots[0].reviewedAt == (existing().slots.size() > 0 ? existing().slots[0].reviewedAt : null) &&
              incoming().slots[0].status in ['DRAFT', 'SUBMITTED', 'REVISION_REQUESTED']
          )) &&
          (incoming().slots.size() < 2 || (
            existing().slots.size() > 1 && existing().slots[1].status == 'APPROVED' ?
              incoming().slots[1] == existing().slots[1] :
              incoming().slots[1].teacherFeedback == (existing().slots.size() > 1 ? existing().slots[1].teacherFeedback : '') &&
              incoming().slots[1].reviewedBy == (existing().slots.size() > 1 ? existing().slots[1].reviewedBy : null) &&
              incoming().slots[1].reviewedAt == (existing().slots.size() > 1 ? existing().slots[1].reviewedAt : null) &&
              incoming().slots[1].status in ['DRAFT', 'SUBMITTED', 'REVISION_REQUESTED']
          )) &&
          isValidSESubmission(incoming())
        ) || (
          (isAdmin() || isJuniorHighStaff()) &&
          existing().unit == 'JUNIOR_HIGH' &&
          incoming().studentId == existing().studentId &&
          incoming().unit == existing().unit &&
          incoming().classId == existing().classId &&
          incoming().academicYear == existing().academicYear &&
          incoming().semester == existing().semester &&
          incoming().periodKey == existing().periodKey &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasAny(['slots', 'overallStatus', 'updatedAt'])
        )
      );

      allow delete: if false;
    }

    match /sePeriods/{periodId} {
      allow read: if isActive() && (
        isJuniorHighStaff() ||
        isAdmin() ||
        isStudent() ||
        isParent()
      );
      allow write: if isActive() && (
        isAdmin() ||
        (isJuniorHighStaff() && (resource == null || resource.data.unitId == 'JUNIOR_HIGH') && (request.resource == null || request.resource.data.unitId == 'JUNIOR_HIGH'))
      );
    }

    match /seReflectionCycles/{cycleId} {
      allow read: if isActive() && (
        isJuniorHighStaff() ||
        isAdmin() ||
        isStudent() ||
        isParent()
      );
      allow write: if isActive() && (
        isAdmin() ||
        (isJuniorHighStaff() && (resource == null || resource.data.unit == 'JUNIOR_HIGH') && (request.resource == null || request.resource.data.unit == 'JUNIOR_HIGH'))
      );
    }

    match /seActivities/{activityId} {
      allow read: if isActive() && (
        isJuniorHighStaff() ||
        isAdmin() ||
        isStudent() ||
        isParent()
      );
      allow write: if isActive() && (
        isAdmin() ||
        (isJuniorHighStaff() && (resource == null || resource.data.unitId == 'JUNIOR_HIGH') && (request.resource == null || request.resource.data.unitId == 'JUNIOR_HIGH'))
      );
    }

    match /seEnrollments/{enrollmentId} {
      allow read: if isActive() && (
        isJuniorHighStaff() ||
        isAdmin() ||
        resource == null ||
        isOwnStudentData(resource.data.studentId) ||
        isLinkedStudent(resource.data.studentId)
      );
      allow write: if isActive() && (
        isJuniorHighStaff() ||
        isAdmin() ||
        (resource == null && isOwnStudentData(incoming().studentId)) ||
        (resource != null && isOwnStudentData(existing().studentId) && isOwnStudentData(incoming().studentId))
      );
    }

    match /seSessionLogs/{logId} {
      allow read: if isActive() && (
        isJuniorHighStaff() ||
        isAdmin() ||
        resource == null ||
        isOwnStudentData(resource.data.studentId) ||
        isLinkedStudent(resource.data.studentId)
      );
      allow write: if isActive() && (
        isJuniorHighStaff() ||
        isAdmin() ||
        (resource == null && isOwnStudentData(incoming().studentId)) ||
        (resource != null && isOwnStudentData(existing().studentId) && isOwnStudentData(incoming().studentId))
      );
    }

    match /seSelfAssessments/{assessmentId} {
      allow read: if isActive() && (
        isJuniorHighStaff() ||
        isAdmin() ||
        resource == null ||
        isOwnStudentData(resource.data.studentId) ||
        isLinkedStudent(resource.data.studentId)
      );
      allow write: if isActive() && (
        isJuniorHighStaff() ||
        isAdmin() ||
        (resource == null && isOwnStudentData(incoming().studentId)) ||
