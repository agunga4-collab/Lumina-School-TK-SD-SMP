        (userRole() == 'HEAD_UNIT') ||
        (isTeacher() && isTeacherAssignedToClass(resource.data.classId)) ||
        isLinkedStudent(resource.data.studentId)
      );
      allow write: if isActive() && (
        isAdmin() ||
        (userRole() == 'HEAD_UNIT') ||
        (isTeacher() && isTeacherAssignedToClass(incoming().classId))
      ) && isValidAAPMidtermReview(incoming()) && (
        (existing() == null) ||
        (existing().reviewStatus != 'completed') ||
        (existing().reviewStatus == 'completed' && incoming().reviewStatus == 'draft')
      );
    }

    match /aap_end_of_term_reports/{reportId} {
      allow read: if isActive() && (
        isAdmin() ||
        (userRole() == 'HEAD_UNIT') ||
        (isTeacher() && isTeacherAssignedToClass(resource.data.classId)) ||
        isLinkedStudent(resource.data.studentId)
      );
      allow write: if isActive() && (
        isAdmin() ||
        (userRole() == 'HEAD_UNIT') ||
        (isTeacher() && isTeacherAssignedToClass(incoming().classId))
      ) && isValidAAPEndOfTermReport(incoming()) && (
        (existing() == null) ||
        (existing().reportStatus != 'completed') ||
        (existing().reportStatus == 'completed' && incoming().reportStatus == 'draft')
      );
    }

    match /learning_goals/{goalId} {
      allow read, write: if isJuniorHighStaff();
    }

