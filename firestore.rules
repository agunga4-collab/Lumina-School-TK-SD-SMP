rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRole() {
      return currentUser().role;
    }

    function isActive() {
      return isSignedIn() && currentUser().status == 'active';
    }

    function isAdmin() {
      return isSignedIn() && (userRole() == 'SUPER_ADMIN' || request.auth.token.email == 'agunga4@gmail.com');
    }

    function isTeacher() {
      return isActive() && (userRole() == 'TEACHER' || userRole() == 'HOMEROOM_TEACHER');
    }

    function isJuniorHighStaff() {
      return isActive() && userRole() in [
        'TEACHER', 'HEAD_JUNIOR', 'BK_MENTOR', 
        'MTSS_ACADEMIC_PJ', 'SUPER_ADMIN', 'HEAD_UNIT',
        'PRINCIPAL', 'VICE_PRINCIPAL', 'COORDINATOR',
        'HOMEROOM_TEACHER', 'COUNSELOR'
      ];
    }

    function isMTSSAcademicManager() {
      return isActive() && (userRole() in ['HEAD_UNIT', 'HEAD_JUNIOR', 'MTSS_ACADEMIC_PJ', 'SUPER_ADMIN']);
    }

    function isParent() {
      return isActive() && userRole() == 'PARENT';
    }

    function isStudent() {
      return isActive() && userRole() == 'STUDENT';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'status']) 
        && data.uid == request.auth.uid 
        && data.email == request.auth.token.email
        && data.role in ['TEACHER', 'HEAD_UNIT', 'HEAD_JUNIOR', 'BK_MENTOR', 'PARENT', 'STUDENT', 'SUPER_ADMIN', 'GUEST', 'MTSS_ACADEMIC_PJ', 'PRINCIPAL', 'VICE_PRINCIPAL', 'COORDINATOR', 'HOMEROOM_TEACHER', 'COUNSELOR']
        && data.status in ['active', 'pending', 'disabled'];
    }

    function isValidMTSSAcademicCase(data) {
      return data.keys().hasAll(['id', 'studentId', 'status', 'currentTier', 'primaryConcern'])
        && data.id is string
        && data.studentId is string
        && data.status in ['SCREENING', 'INITIAL_MEETING', 'ACTIVE', 'UNDER_REVIEW', 'ESCALATED', 'CLOSED']
        && data.currentTier in ['Tier 1', 'Tier 2', 'Tier 3'];
    }

    function isValidMTSSAcademicAlert(data) {
      return data.keys().hasAll(['id', 'caseId', 'type', 'severity', 'status'])
        && data.id is string
        && data.caseId is string
        && data.severity in ['INFO', 'WARNING', 'CRITICAL']
        && data.status in ['OPEN', 'ACKNOWLEDGED', 'RESOLVED', 'DISMISSED', 'ARCHIVED'];
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && userId == request.auth.uid && isValidUser(incoming());
      allow update: if (isAdmin() || (userId == request.auth.uid && incoming().role == existing().role && incoming().status == existing().status )) && isValidUser(incoming());
    }

    match /roleInvites/{inviteId} {
      allow read: if isSignedIn() && (isAdmin() || (resource != null && resource.data.email.lower() == request.auth.token.email.lower()));
      allow write: if isAdmin();
      allow update: if (isSignedIn() && incoming().status == 'used' && existing().status == 'ready' && incoming().email.lower() == request.auth.token.email.lower());
    }

    match /students/{studentId} {
      allow read: if isActive();
      allow write: if isAdmin() || isJuniorHighStaff();
    }

    match /classes/{classId} {
      allow read: if isActive();
      allow write: if isAdmin() || isMTSSAcademicManager();
    }

    match /systemConfig/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isActive();
      allow write: if isAdmin() || isMTSSAcademicManager();
    }

    // MTSS Behavioral
    match /behaviorCases/{caseId} {
      allow read: if isActive() && (isJuniorHighStaff() || (isParent() && existing().studentId in currentUser().linkedStudents));
      allow create: if isJuniorHighStaff() && incoming().keys().hasAll(['studentId', 'status', 'tier']);
      allow update: if isAdmin() || isJuniorHighStaff();
      allow delete: if isAdmin();

      match /concerns/{concernId} {
        allow read: if isActive() && isJuniorHighStaff();
        allow create: if isJuniorHighStaff();
        allow update, delete: if isAdmin() || (isJuniorHighStaff() && existing().reporterId == request.auth.uid);
      }
    }

    // MTSS Academic
    match /juniorhigh_mtss_academic_cases/{caseId} {
      allow read: if isActive() && (isJuniorHighStaff() || (isParent() && existing().studentId in currentUser().linkedStudents));
      allow create: if isJuniorHighStaff() && isValidMTSSAcademicCase(incoming());
      allow update: if isAdmin() || isJuniorHighStaff();
      allow delete: if isAdmin();

      match /goals/{goalId} {
        allow read: if isJuniorHighStaff();
        allow write: if isJuniorHighStaff();
      }

      match /sessions/{sessionId} {
        allow read: if isJuniorHighStaff() || (isParent() && get(/databases/$(database)/documents/juniorhigh_mtss_academic_cases/$(caseId)).data.studentId in currentUser().linkedStudents);
        allow write: if isJuniorHighStaff();
      }

      match /meetings/{meetingId} {
        allow read: if isJuniorHighStaff();
        allow write: if isJuniorHighStaff();
      }

      match /plans/{planId} {
        allow read: if isJuniorHighStaff();
        allow write: if isJuniorHighStaff();
      }

      match /evaluations/{evaluationId} {
        allow read: if isJuniorHighStaff() || (isParent() && get(/databases/$(database)/documents/juniorhigh_mtss_academic_cases/$(caseId)).data.studentId in currentUser().linkedStudents);
        allow write: if isJuniorHighStaff();
      }

      match /parentDocuments/{docId} {
        allow read: if isJuniorHighStaff() || (isParent() && get(/databases/$(database)/documents/juniorhigh_mtss_academic_cases/$(caseId)).data.studentId in currentUser().linkedStudents);
        allow write: if isJuniorHighStaff();
      }

      match /audits/{auditId} {
        allow read: if isJuniorHighStaff();
        allow create: if isJuniorHighStaff();
      }
    }

    match /juniorhigh_mtss_academic_alerts/{alertId} {
      allow read: if isJuniorHighStaff();
      allow write: if isJuniorHighStaff() && isValidMTSSAcademicAlert(incoming());
    }

    match /juniorhigh_mtss_academic_timeline/{phaseId} {
      allow read: if isJuniorHighStaff();
      allow write: if isMTSSAcademicManager();
    }

    match /juniorhigh_mtss_academic_documents/{docId} {
      allow read: if isJuniorHighStaff();
      allow write: if isJuniorHighStaff();
    }

    match /juniorhigh_mtss_academic_backup_config/{configId} {
      allow read: if isJuniorHighStaff();
      allow write: if isAdmin();
    }

    match /cicoSessions/{sessionId} {
      allow read: if isActive() && (isJuniorHighStaff() || (isParent() && existing().studentId in currentUser().linkedStudents));
      allow write: if isJuniorHighStaff();
    }

    match /cicoGoalConfigs/{caseId} {
      allow read: if isActive() && isJuniorHighStaff();
      allow write: if isJuniorHighStaff();
    }

    match /bipPlans/{planId} {
      allow read: if isActive() && (isJuniorHighStaff() && (userRole() in ['BK_MENTOR', 'HEAD_JUNIOR', 'SUPER_ADMIN']));
      allow write: if isAdmin() || (isActive() && userRole() in ['BK_MENTOR', 'HEAD_JUNIOR']);
    }

    match /reflections/{reflectionId} {
      allow read: if isActive() && (
        (isStudent() && existing().studentId == request.auth.uid) || isJuniorHighStaff()
      );
      allow create: if isStudent() || isJuniorHighStaff();
      allow update: if isAdmin() || (isStudent() && existing().studentId == request.auth.uid);
    }

    match /literacyProgress/{progressId} {
      allow read: if isActive();
      allow write: if isJuniorHighStaff();
    }

    match /elementary_literacy_numeracy/{recordId} {
      allow read: if isActive();
      allow write: if isTeacher() || isAdmin() || isJuniorHighStaff();
    }

    match /selfExploration/{studentId} {
      allow read: if isActive() && (
        (isStudent() && studentId == request.auth.uid) || isJuniorHighStaff()
      );
      allow write: if isAdmin() || (isStudent() && studentId == request.auth.uid);
    }

    match /attendance/{attendanceId} {
      allow read: if isActive();
      allow write: if isJuniorHighStaff();
    }

    match /observations/{observationId} {
      allow read: if isActive();
      allow write: if isJuniorHighStaff();
    }

    match /learning_goals/{goalId} {
      allow read: if isJuniorHighStaff();
      allow write: if isJuniorHighStaff();
    }

    match /lxd/{lxdId} {
      allow read: if isJuniorHighStaff();
      allow write: if isJuniorHighStaff();
    }

    match /assessments/{assessmentId} {
      allow read: if isJuniorHighStaff();
      allow write: if isJuniorHighStaff();
    }

    match /reportCards/{reportId} {
      allow read: if isSignedIn() && (
        isJuniorHighStaff() || (isParent() && existing().status == "PUBLISHED")
      );
      allow write: if isJuniorHighStaff();
    }

    match /reportConfig/{unitId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isMTSSAcademicManager();
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn() && (existing().userId == request.auth.token.email || isAdmin());
      allow update: if isSignedIn() && existing().userId == request.auth.token.email && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
      allow create: if isSignedIn();
    }

    match /behavior_notifications/{notifId} {
      allow read: if isSignedIn() && (request.auth.uid in existing().targetUserIds || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        (request.auth.uid in existing().targetUserIds && incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'isDismissed']))
        || isAdmin()
      );
    }

    match /parentStudentLinks/{linkId} {
      allow read: if isSignedIn() && (isAdmin() || linkId.split('_')[0] == request.auth.token.email);
      allow write: if isAdmin();
    }

    match /parentReportViews/{viewId} {
      allow read, write: if isSignedIn() && (isAdmin() || viewId.split('_')[0] == request.auth.token.email);
    }

    match /clubs/{clubId} {
      allow read: if isSignedIn();
      allow write: if isJuniorHighStaff();
    }

    match /promptTemplates/{promptId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /knowledgeBase/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}

