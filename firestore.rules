rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserExists() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRole() {
      return currentUserExists() ? currentUser().role : 'GUEST';
    }

    function isActive() {
      return isSignedIn() &&
        currentUserExists() &&
        currentUser().status == 'active';
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email in ['agunga4@gmail.com', 'agunga4@lazuardi.sch.id']) ||
        (currentUserExists() && userRole() == 'SUPER_ADMIN')
      );
    }

    function isTeacher() {
      return isActive() &&
        (userRole() == 'TEACHER' || userRole() == 'HOMEROOM_TEACHER');
    }

    function isJuniorHighStaff() {
      return isActive() && userRole() in [
        'TEACHER', 'HEAD_JUNIOR', 'BK_MENTOR',
        'MTSS_ACADEMIC_PJ', 'SUPER_ADMIN', 'HEAD_UNIT',
        'PRINCIPAL', 'VICE_PRINCIPAL', 'COORDINATOR',
        'HOMEROOM_TEACHER', 'COUNSELOR'
      ];
    }

    function isJHConferenceStaff() {
      return isActive() && userRole() in [
        'SUPER_ADMIN', 'HEAD_UNIT', 'HEAD_JUNIOR', 'TEACHER', 'BK_MENTOR'
      ];
    }

    function isMTSSAcademicManager() {
      return isActive() && userRole() in [
        'HEAD_UNIT', 'HEAD_JUNIOR', 'MTSS_ACADEMIC_PJ', 'SUPER_ADMIN'
      ];
    }

    function isParent() {
      return isActive() && userRole() == 'PARENT';
    }

    function isStudent() {
      return isActive() && userRole() == 'STUDENT';
    }

    function hasLinkedStudentsField() {
      return currentUserExists() && ('linkedStudents' in currentUser());
    }

    function parentLinkDocExists() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/parentStudentLinks/$(request.auth.token.email.lower()));
    }

    function parentLinkDoc() {
      return request.auth.token.email != null ? get(/databases/$(database)/documents/parentStudentLinks/$(request.auth.token.email.lower())).data : {};
    }

    function isLinkedStudent(studentId) {
      return isParent() && studentId is string && (
        (
          hasLinkedStudentsField() && (
            studentId in currentUser().linkedStudents ||
            studentId.lower() in currentUser().linkedStudents ||
            studentId.upper() in currentUser().linkedStudents
          )
        ) || (
          parentLinkDocExists() &&
          ('studentIds' in parentLinkDoc()) && (
            studentId in parentLinkDoc().studentIds ||
            studentId.lower() in parentLinkDoc().studentIds ||
            studentId.upper() in parentLinkDoc().studentIds
          )
        )
      );
    }

    function isOwnStudentData(studentId) {
      return isStudent() && studentId is string && currentUserExists() &&
        ('luminaId' in currentUser()) &&
        currentUser().luminaId == studentId;
    }

    function isTeacherAssignedToClass(classId) {
      return exists(/databases/$(database)/documents/classes/$(classId)) && (
        get(/databases/$(database)/documents/classes/$(classId)).data.homeroomTeacherId == request.auth.uid ||
        (get(/databases/$(database)/documents/classes/$(classId)).data.homeroomTeacherIds != null && request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.homeroomTeacherIds) ||
        (get(/databases/$(database)/documents/classes/$(classId)).data.waliKelasIds != null && request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.waliKelasIds) ||
        (get(/databases/$(database)/documents/classes/$(classId)).data.assignedTeacherIds != null && request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.assignedTeacherIds) ||
        (get(/databases/$(database)/documents/classes/$(classId)).data.gpkTeacherIds != null && request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.gpkTeacherIds)
      );
    }

    function isValidAAPAssessment(data) {
      return data.studentId != null && data.studentId != "" &&
             data.classId != null && data.classId != "" &&
             data.academicYear != null && data.academicYear != "";
    }

    function isValidAAPFollowupPlan(data) {
      return data.studentId != null && data.studentId != "" &&
             data.classId != null && data.classId != "" &&
             data.academicYear != null && data.academicYear != "";
    }

    function isValidAAPMidtermReview(data) {
      return data.studentId != null && data.studentId != "" &&
             data.classId != null && data.classId != "" &&
             data.academicYearId != null && data.academicYearId != "" &&
             data.termId != null && data.termId != "";
    }

    function isValidAAPEndOfTermReport(data) {
      return data.studentId != null && data.studentId != "" &&
             data.classId != null && data.classId != "" &&
             data.academicYearId != null && data.academicYearId != "" &&
             data.termId != null && data.termId != "";
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidSESubmission(data) {
      return data.overallStatus != 'SUBMITTED' || (
        data.slots != null &&
        data.slots.size() > 0 &&
        data.slots[0].reflectionText is string &&
        data.slots[0].reflectionText.size() >= 80 &&
        (data.gradeSnapshot == 9 || (
          data.slots.size() > 1 &&
          data.slots[1].reflectionText is string &&
          data.slots[1].reflectionText.size() >= 80
        ))
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'status'])
        && data.uid == request.auth.uid
        && (request.auth.token.email == null || data.email.lower() == request.auth.token.email.lower())
        && data.role in [
          'TEACHER', 'HEAD_UNIT', 'HEAD_JUNIOR', 'BK_MENTOR',
          'PARENT', 'STUDENT', 'SUPER_ADMIN', 'GUEST',
          'MTSS_ACADEMIC_PJ', 'PRINCIPAL', 'VICE_PRINCIPAL',
          'COORDINATOR', 'HOMEROOM_TEACHER', 'COUNSELOR',
          'kindergarten_subject_teacher'
        ]
        && data.status in ['active', 'pending', 'disabled'];
    }

    function isValidMTSSAcademicCase(data) {
      return data.keys().hasAll(['id', 'studentId', 'status', 'currentTier', 'primaryConcern'])
        && data.id is string
        && data.studentId is string
        && data.status in [
          'SCREENING', 'INITIAL_MEETING', 'ACTIVE',
          'UNDER_REVIEW', 'ESCALATED', 'CLOSED'
        ]
        && data.currentTier in ['Tier 1', 'Tier 2', 'Tier 3'];
    }

    function isValidMTSSAcademicAlert(data) {
      return data.keys().hasAll(['id', 'caseId', 'type', 'severity', 'status'])
        && data.id is string
        && data.caseId is string
        && data.severity in ['INFO', 'WARNING', 'CRITICAL']
        && data.status in ['OPEN', 'ACKNOWLEDGED', 'RESOLVED', 'DISMISSED', 'ARCHIVED'];
    }

    function isValidClassAnecdote(data) {
      return data.keys().hasAll([
        'studentId', 'studentName', 'classId', 'className', 'unit',
        'academicYearId', 'date', 'time', 'activityContext', 'anecdote',
        'followUp', 'createdBy', 'createdAt', 'updatedAt'
      ])
      && data.keys().size() == 14
      && data.studentId is string && data.studentId.size() <= 128
      && data.studentName is string && data.studentName.size() <= 200
      && data.classId is string && data.classId.size() <= 128
      && data.className is string && data.className.size() <= 128
      && data.unit == 'ELEMENTARY'
      && data.academicYearId is string && data.academicYearId.size() <= 32
      && data.date is timestamp
      && data.time is string && data.time.size() <= 32
      && data.activityContext is string && data.activityContext.size() <= 500
      && data.anecdote is string && data.anecdote.size() <= 5000
      && (data.followUp == null || (data.followUp is string && data.followUp.size() <= 2000))
      && data.createdBy is map
      && data.createdBy.uid == request.auth.uid
      && data.createdBy.name is string && data.createdBy.name.size() <= 200
      && data.createdBy.role is string && data.createdBy.role.size() <= 128
      && data.createdAt == request.time
      && data.updatedAt == request.time;
    }

    function isValidClassAnecdoteUpdate(data) {
      return data.keys().hasAll([
        'studentId', 'studentName', 'classId', 'className', 'unit',
        'academicYearId', 'date', 'time', 'activityContext', 'anecdote',
        'followUp', 'createdBy', 'createdAt', 'updatedAt'
      ])
      && data.keys().size() == 14
      && data.studentId is string && data.studentId.size() <= 128
      && data.studentName is string && data.studentName.size() <= 200
      && data.classId is string && data.classId.size() <= 128
      && data.className is string && data.className.size() <= 128
      && data.unit == 'ELEMENTARY'
      && data.academicYearId is string && data.academicYearId.size() <= 32
      && data.date is timestamp
      && data.time is string && data.time.size() <= 32
      && data.activityContext is string && data.activityContext.size() <= 500
      && data.anecdote is string && data.anecdote.size() <= 5000
      && (data.followUp == null || (data.followUp is string && data.followUp.size() <= 2000))
      && data.createdBy is map
      && data.createdBy.uid is string && data.createdBy.uid.size() <= 128
      && data.createdBy.name is string && data.createdBy.name.size() <= 200
      && data.createdBy.role is string && data.createdBy.role.size() <= 128
      && data.createdAt is timestamp
      && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin() || (
        isJHConferenceStaff() &&
        resource.data.status == 'active' &&
        resource.data.role in [
          'TEACHER', 'HOMEROOM_TEACHER', 'BK_MENTOR',
          'HEAD_JUNIOR', 'HEAD_UNIT', 'SUPER_ADMIN'
        ]
      );
      allow create: if isSignedIn() && userId == request.auth.uid && isValidUser(incoming());
      allow update: if isAdmin()
        || (isSignedIn()
          && userId == request.auth.uid
          && incoming().role == existing().role
          && (incoming().status == existing().status || (existing().status == 'ready' && incoming().status == 'active'))
          && isValidUser(incoming()));
    }

    match /onboarding/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && userId == request.auth.uid;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /roleInvites/{inviteId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isSignedIn() && (
        isAdmin() || (
          resource.data.status == 'ready' &&
          request.resource.data.status == 'used'
        )
      );
      allow delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isActive();
      allow write: if isAdmin() || isJuniorHighStaff();
    }

    match /classes/{classId} {
      allow read: if isActive();
      allow create, delete: if isAdmin() || isMTSSAcademicManager();
      allow update: if isAdmin() || isMTSSAcademicManager() || (
        isSignedIn() &&
        existing().homeroomTeacherId is string &&
        existing().homeroomTeacherId.startsWith('INVITE_') &&
        incoming().homeroomTeacherId == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['homeroomTeacherId', 'homeroomTeacherName'])
      );
    }

    match /systemConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /systemSettings/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isActive();
      allow write: if isAdmin() || isMTSSAcademicManager();
    }

    match /behaviorCases/{caseId} {
      allow read: if isActive() && isJuniorHighStaff();
      allow read: if isActive() && isLinkedStudent(existing().studentId);
      allow create: if isJuniorHighStaff() && incoming().keys().hasAll(['studentId', 'status', 'tier']);
      allow update: if isAdmin() || isJuniorHighStaff();
      allow delete: if isAdmin();

      match /concerns/{concernId} {
        allow read: if isActive() && isJuniorHighStaff();
        allow create: if isJuniorHighStaff();
        allow update, delete: if isAdmin() || (isJuniorHighStaff() && existing().reporterId == request.auth.uid);
      }
    }

    match /juniorhigh_mtss_academic_cases/{caseId} {
      allow read: if isActive() && isJuniorHighStaff();
      allow read: if isActive() && isLinkedStudent(existing().studentId);
      allow create: if isJuniorHighStaff() && isValidMTSSAcademicCase(incoming());
      allow update: if isAdmin() || isJuniorHighStaff();
      allow delete: if isAdmin();

      match /goals/{goalId} {
        allow read, write: if isJuniorHighStaff();
      }

      match /sessions/{sessionId} {
        allow read: if isJuniorHighStaff()
          || isLinkedStudent(get(/databases/$(database)/documents/juniorhigh_mtss_academic_cases/$(caseId)).data.studentId);
        allow write: if isJuniorHighStaff();
      }

      match /meetings/{meetingId} {
        allow read, write: if isJuniorHighStaff();
      }

      match /plans/{planId} {
        allow read, write: if isJuniorHighStaff();
      }

      match /evaluations/{evaluationId} {
        allow read: if isJuniorHighStaff()
          || isLinkedStudent(get(/databases/$(database)/documents/juniorhigh_mtss_academic_cases/$(caseId)).data.studentId);
        allow write: if isJuniorHighStaff();
      }

      match /parentDocuments/{docId} {
        allow read: if isJuniorHighStaff()
          || isLinkedStudent(get(/databases/$(database)/documents/juniorhigh_mtss_academic_cases/$(caseId)).data.studentId);
        allow write: if isJuniorHighStaff();
      }

      match /audits/{auditId} {
        allow read, create: if isJuniorHighStaff();
      }
    }

    match /juniorhigh_mtss_academic_alerts/{alertId} {
      allow read: if isJuniorHighStaff();
      allow write: if isJuniorHighStaff() && isValidMTSSAcademicAlert(incoming());
    }

    match /juniorhigh_mtss_academic_timeline/{phaseId} {
      allow read: if isJuniorHighStaff();
      allow write: if isMTSSAcademicManager();
    }

    match /juniorhigh_mtss_academic_documents/{docId} {
      allow read, write: if isJuniorHighStaff();
    }

    match /juniorhigh_mtss_academic_backup_config/{configId} {
      allow read: if isJuniorHighStaff();
      allow write: if isAdmin();
    }

    match /juniorhigh_mtss_tier1_assessments/{assessmentId} {
      allow read, write: if isJuniorHighStaff();
    }

    match /cicoSessions/{sessionId} {
      allow read: if isActive() && isJuniorHighStaff();
      allow read: if isActive() && isLinkedStudent(existing().studentId);
      allow write: if isJuniorHighStaff();
    }

    match /cicoGoalConfigs/{caseId} {
      allow read, write: if isActive() && isJuniorHighStaff();
    }

    match /bipPlans/{planId} {
      allow read: if isActive() && isJuniorHighStaff() && (userRole() in ['BK_MENTOR', 'HEAD_JUNIOR', 'SUPER_ADMIN']);
      allow write: if isAdmin() || (isActive() && userRole() in ['BK_MENTOR', 'HEAD_JUNIOR']);
    }

    match /reflections/{reflectionId} {
      allow read: if isActive() && isJuniorHighStaff();
      allow read: if isActive() && isStudent() && existing().studentId == request.auth.uid;
      allow read: if isActive() && isLinkedStudent(existing().studentId);
      allow create: if isStudent() || isJuniorHighStaff();
      allow update: if isAdmin() || (isStudent() && existing().studentId == request.auth.uid);
    }

    match /literacyProgress/{progressId} {
      allow read: if isActive() && isJuniorHighStaff();
      allow read: if isActive() && isLinkedStudent(existing().studentId);
      allow write: if isJuniorHighStaff();
    }

    match /junior_high_literacy_numeracy_records/{recordId} {
      allow read: if isActive() && isJuniorHighStaff();
      allow read: if isActive() && isLinkedStudent(existing().studentId);
      allow write: if isJuniorHighStaff();
    }

    match /cicoWeeklyReflections/{reflectionId} {
      allow read: if isActive() && isJuniorHighStaff();
      allow read: if isActive() && isLinkedStudent(existing().studentId);
      allow write: if isJuniorHighStaff();
    }

    match /elementary_mtss_cases/{caseId} {
      allow read: if isActive() && (isTeacher() || isAdmin() || isJuniorHighStaff() || isLinkedStudent(resource.data.studentId));
      allow write: if isTeacher() || isAdmin() || isJuniorHighStaff();

      match /coaching_sessions/{sessionId} {
        allow read: if isActive() && (isTeacher() || isAdmin() || isJuniorHighStaff() || isLinkedStudent(get(/databases/$(database)/documents/elementary_mtss_cases/$(caseId)).data.studentId));
        allow write: if isTeacher() || isAdmin() || isJuniorHighStaff();
      }
    }

    match /elementary_mtss_batch_sheets/{sheetId} {
      allow read, write: if isActive() && (isTeacher() || isAdmin() || isJuniorHighStaff());
    }

    match /elementary_literacy_numeracy/{recordId} {
      allow read: if isActive() && (isTeacher() || isAdmin() || isJuniorHighStaff() || isLinkedStudent(existing().studentId));
      allow write: if isTeacher() || isAdmin() || isJuniorHighStaff();
    }

    match /elementary_literacy_numeracy_records/{recordId} {
      allow read: if isActive() && (isTeacher() || isAdmin() || isJuniorHighStaff() || isLinkedStudent(existing().studentId));
      allow write: if isTeacher() || isAdmin() || isJuniorHighStaff();
    }

    match /elementaryLiteracyNumeracySheetConfigs/{configId} {
      allow read: if isActive() && (isTeacher() || isAdmin() || isJuniorHighStaff());
      allow write: if isAdmin();
    }

    match /selfExploration/{studentId} {
      allow read: if isActive() && (
        isOwnStudentData(studentId) ||
        (isStudent() && studentId == request.auth.uid) ||
        isJuniorHighStaff() ||
        isAdmin() ||
        isLinkedStudent(studentId)
      );
      allow write: if isActive() && (
        isAdmin() ||
        isJuniorHighStaff() ||
        (isStudent() && studentId == request.auth.uid) ||
        isOwnStudentData(studentId)
      );

      match /plans/{periodId} {
        allow read: if isActive() && (
          isOwnStudentData(studentId) ||
          (isStudent() && studentId == request.auth.uid) ||
          isJuniorHighStaff() ||
          isAdmin() ||
          isLinkedStudent(studentId)
        );
        allow write: if isActive() && (
          isAdmin() ||
          isJuniorHighStaff() ||
          (isStudent() && studentId == request.auth.uid) ||
          isOwnStudentData(studentId)
        );
      }
    }

    match /seMonthlyReflections/{reflectionId} {
      allow get: if isActive() && (
        resource == null ||
        isOwnStudentData(resource.data.studentId) ||
        isAdmin() ||
        (isJuniorHighStaff() && resource.data.unit == 'JUNIOR_HIGH') ||
        isLinkedStudent(resource.data.studentId)
      );

      allow list: if isActive() && (
        isAdmin() ||
        (isJuniorHighStaff() && resource.data.unit == 'JUNIOR_HIGH')
      );

      allow create: if isActive() && (
        isOwnStudentData(incoming().studentId) &&
        incoming().unit == 'JUNIOR_HIGH' &&
        incoming().overallStatus in ['DRAFT', 'SUBMITTED'] &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        reflectionId.split('_')[0] == incoming().studentId &&
        isValidSESubmission(incoming())
      );

      allow update: if isActive() && (
        (
          isOwnStudentData(existing().studentId) &&
          incoming().studentId == existing().studentId &&
          incoming().unit == 'JUNIOR_HIGH' &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().classId == existing().classId &&
          incoming().academicYear == existing().academicYear &&
          incoming().semester == existing().semester &&
          incoming().periodKey == existing().periodKey &&
          (!('reflectionCycleId' in existing()) || (incoming().reflectionCycleId == existing().reflectionCycleId)) &&
          (!('sePeriodId' in existing()) || (incoming().sePeriodId == existing().sePeriodId)) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['slots', 'overallStatus', 'updatedAt', 'reflectionCycleId', 'sePeriodId']) &&
          existing().overallStatus in ['DRAFT', 'REVISION_REQUESTED'] &&
          incoming().overallStatus in ['DRAFT', 'SUBMITTED'] &&
          (incoming().slots.size() > 0 && (
            existing().slots.size() > 0 && existing().slots[0].status == 'APPROVED' ?
              incoming().slots[0] == existing().slots[0] :
              incoming().slots[0].teacherFeedback == (existing().slots.size() > 0 ? existing().slots[0].teacherFeedback : '') &&
              incoming().slots[0].reviewedBy == (existing().slots.size() > 0 ? existing().slots[0].reviewedBy : null) &&
              incoming().slots[0].reviewedAt == (existing().slots.size() > 0 ? existing().slots[0].reviewedAt : null) &&
              incoming().slots[0].status in ['DRAFT', 'SUBMITTED', 'REVISION_REQUESTED']
          )) &&
          (incoming().slots.size() < 2 || (
            existing().slots.size() > 1 && existing().slots[1].status == 'APPROVED' ?
              incoming().slots[1] == existing().slots[1] :
              incoming().slots[1].teacherFeedback == (existing().slots.size() > 1 ? existing().slots[1].teacherFeedback : '') &&
              incoming().slots[1].reviewedBy == (existing().slots.size() > 1 ? existing().slots[1].reviewedBy : null) &&
              incoming().slots[1].reviewedAt == (existing().slots.size() > 1 ? existing().slots[1].reviewedAt : null) &&
              incoming().slots[1].status in ['DRAFT', 'SUBMITTED', 'REVISION_REQUESTED']
          )) &&
          isValidSESubmission(incoming())
        ) || (
          (isAdmin() || isJuniorHighStaff()) &&
          existing().unit == 'JUNIOR_HIGH' &&
          incoming().studentId == existing().studentId &&
          incoming().unit == existing().unit &&
          incoming().classId == existing().classId &&
          incoming().academicYear == existing().academicYear &&
          incoming().semester == existing().semester &&
          incoming().periodKey == existing().periodKey &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasAny(['slots', 'overallStatus', 'updatedAt'])
        )
      );

      allow delete: if false;
    }

    match /sePeriods/{periodId} {
      allow read: if isActive() && (
        isJuniorHighStaff() ||
        isAdmin() ||
        isStudent() ||
        isParent()
      );
      allow write: if isActive() && (
        isAdmin() ||
        (isJuniorHighStaff() && (resource == null || resource.data.unitId == 'JUNIOR_HIGH') && (request.resource == null || request.resource.data.unitId == 'JUNIOR_HIGH'))
      );
    }

    match /seReflectionCycles/{cycleId} {
      allow read: if isActive() && (
        isJuniorHighStaff() ||
        isAdmin() ||
        isStudent() ||
        isParent()
      );
      allow write: if isActive() && (
        isAdmin() ||
        (isJuniorHighStaff() && (resource == null || resource.data.unit == 'JUNIOR_HIGH') && (request.resource == null || request.resource.data.unit == 'JUNIOR_HIGH'))
      );
    }

    match /seActivities/{activityId} {
      allow read: if isActive() && (
        isJuniorHighStaff() ||
        isAdmin() ||
        isStudent() ||
        isParent()
      );
      allow write: if isActive() && (
        isAdmin() ||
        (isJuniorHighStaff() && (resource == null || resource.data.unitId == 'JUNIOR_HIGH') && (request.resource == null || request.resource.data.unitId == 'JUNIOR_HIGH'))
      );
    }

    match /seEnrollments/{enrollmentId} {
      allow read: if isActive() && (
        isJuniorHighStaff() ||
        isAdmin() ||
        resource == null ||
        isOwnStudentData(resource.data.studentId) ||
        isLinkedStudent(resource.data.studentId)
      );
      allow write: if isActive() && (
        isJuniorHighStaff() ||
        isAdmin() ||
        (resource == null && isOwnStudentData(incoming().studentId)) ||
        (resource != null && isOwnStudentData(existing().studentId) && isOwnStudentData(incoming().studentId))
      );
    }

    match /seSessionLogs/{logId} {
      allow read: if isActive() && (
