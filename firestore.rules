      allow read: if isActive() && (
        isAdmin() ||
        (userRole() == 'HEAD_UNIT') ||
        (isTeacher() && isTeacherAssignedToClass(resource.data.classId)) ||
        isLinkedStudent(resource.data.studentId)
      );
      allow write: if isActive() && (
        isAdmin() ||
        (userRole() == 'HEAD_UNIT') ||
        (isTeacher() && isTeacherAssignedToClass(incoming().classId))
      ) && isValidAAPAssessment(incoming());
    }

    match /aap_followup_plans/{planId} {
      allow read: if isActive() && (
        isAdmin() ||
        (userRole() == 'HEAD_UNIT') ||
        (isTeacher() && isTeacherAssignedToClass(resource.data.classId)) ||
        isLinkedStudent(resource.data.studentId)
      );
      allow write: if isActive() && (
        isAdmin() ||
        (userRole() == 'HEAD_UNIT') ||
        (isTeacher() && isTeacherAssignedToClass(incoming().classId))
      ) && isValidAAPFollowupPlan(incoming());
    }

    match /aap_followup_plan_evidence/{evidenceId} {
      allow read: if isActive() && (
        isAdmin() ||
        (userRole() == 'HEAD_UNIT') ||
        (isTeacher() && isTeacherAssignedToClass(resource.data.classId)) ||
        isLinkedStudent(resource.data.studentId)
      );
      allow create, update: if isActive() && (
        isAdmin() ||
        (userRole() == 'HEAD_UNIT') ||
        (isTeacher() && isTeacherAssignedToClass(incoming().classId))
      );
      allow delete: if isActive() && (
        isAdmin() ||
        (userRole() == 'HEAD_UNIT') ||
        (isTeacher() && isTeacherAssignedToClass(resource.data.classId))
      );
    }

    match /aap_midterm_reviews/{reviewId} {
