rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserExists() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRole() {
      return currentUserExists() ? currentUser().role : 'GUEST';
    }

    function isActive() {
      return isSignedIn() &&
        currentUserExists() &&
        currentUser().status == 'active';
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email in ['agunga4@gmail.com', 'agunga4@lazuardi.sch.id']) ||
        (currentUserExists() && userRole() == 'SUPER_ADMIN')
      );
    }

    function isTeacher() {
      return isActive() &&
        (userRole() == 'TEACHER' || userRole() == 'HOMEROOM_TEACHER');
    }

    function isJuniorHighStaff() {
      return isActive() && userRole() in [
        'TEACHER', 'HEAD_JUNIOR', 'BK_MENTOR',
        'MTSS_ACADEMIC_PJ', 'SUPER_ADMIN', 'HEAD_UNIT',
        'PRINCIPAL', 'VICE_PRINCIPAL', 'COORDINATOR',
        'HOMEROOM_TEACHER', 'COUNSELOR'
      ];
    }

    function isJHConferenceStaff() {
      return isActive() && userRole() in [
        'SUPER_ADMIN', 'HEAD_UNIT', 'HEAD_JUNIOR', 'TEACHER', 'BK_MENTOR'
      ];
    }

    function isMTSSAcademicManager() {
      return isActive() && userRole() in [
        'HEAD_UNIT', 'HEAD_JUNIOR', 'MTSS_ACADEMIC_PJ', 'SUPER_ADMIN'
      ];
    }

    function isParent() {
      return isActive() && userRole() == 'PARENT';
    }

    function isStudent() {
      return isActive() && userRole() == 'STUDENT';
    }

    function hasLinkedStudentsField() {
      return currentUserExists() && ('linkedStudents' in currentUser());
    }

    function parentLinkDocExists() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/parentStudentLinks/$(request.auth.token.email.lower()));
    }

    function parentLinkDoc() {
      return request.auth.token.email != null ? get(/databases/$(database)/documents/parentStudentLinks/$(request.auth.token.email.lower())).data : {};
    }

    function isLinkedStudent(studentId) {
      return isParent() && studentId is string && (
        (
          hasLinkedStudentsField() && (
            studentId in currentUser().linkedStudents ||
            studentId.lower() in currentUser().linkedStudents ||
            studentId.upper() in currentUser().linkedStudents
          )
        ) || (
          parentLinkDocExists() &&
          ('studentIds' in parentLinkDoc()) && (
            studentId in parentLinkDoc().studentIds ||
            studentId.lower() in parentLinkDoc().studentIds ||
            studentId.upper() in parentLinkDoc().studentIds
          )
        )
      );
    }

    function isOwnStudentData(studentId) {
      return isStudent() && studentId is string && currentUserExists() &&
        ('luminaId' in currentUser()) &&
        currentUser().luminaId == studentId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'status'])
        && data.uid == request.auth.uid
        && (request.auth.token.email == null || data.email.lower() == request.auth.token.email.lower())
        && data.role in [
          'TEACHER', 'HEAD_UNIT', 'HEAD_JUNIOR', 'BK_MENTOR',
          'PARENT', 'STUDENT', 'SUPER_ADMIN', 'GUEST',
          'MTSS_ACADEMIC_PJ', 'PRINCIPAL', 'VICE_PRINCIPAL',
          'COORDINATOR', 'HOMEROOM_TEACHER', 'COUNSELOR'
        ]
        && data.status in ['active', 'pending', 'disabled'];
    }

    function isValidMTSSAcademicCase(data) {
      return data.keys().hasAll(['id', 'studentId', 'status', 'currentTier', 'primaryConcern'])
        && data.id is string
        && data.studentId is string
        && data.status in [
          'SCREENING', 'INITIAL_MEETING', 'ACTIVE',
          'UNDER_REVIEW', 'ESCALATED', 'CLOSED'
        ]
        && data.currentTier in ['Tier 1', 'Tier 2', 'Tier 3'];
    }

    function isValidMTSSAcademicAlert(data) {
      return data.keys().hasAll(['id', 'caseId', 'type', 'severity', 'status'])
        && data.id is string
        && data.caseId is string
        && data.severity in ['INFO', 'WARNING', 'CRITICAL']
        && data.status in ['OPEN', 'ACKNOWLEDGED', 'RESOLVED', 'DISMISSED', 'ARCHIVED'];
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && userId == request.auth.uid && isValidUser(incoming());
      allow update: if isAdmin()
        || (isSignedIn()
          && userId == request.auth.uid
          && incoming().role == existing().role
          && incoming().status == existing().status
          && isValidUser(incoming()));
    }

    match /onboarding/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && userId == request.auth.uid;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /roleInvites/{inviteId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isSignedIn() && (
        isAdmin() || (
          resource.data.status == 'ready' &&
          request.resource.data.status == 'used'
        )
      );
      allow delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isActive();
      allow write: if isAdmin() || isJuniorHighStaff();
    }

    match /classes/{classId} {
      allow read: if isActive();
      allow write: if isAdmin() || isMTSSAcademicManager();
    }

    match /systemConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isActive();
      allow write: if isAdmin() || isMTSSAcademicManager();
    }

    match /behaviorCases/{caseId} {
      allow read: if isActive() && isJuniorHighStaff();
      allow read: if isActive() && isLinkedStudent(existing().studentId);
      allow create: if isJuniorHighStaff() && incoming().keys().hasAll(['studentId', 'status', 'tier']);
      allow update: if isAdmin() || isJuniorHighStaff();
      allow delete: if isAdmin();

      match /concerns/{concernId} {
        allow read: if isActive() && isJuniorHighStaff();
        allow create: if isJuniorHighStaff();
        allow update, delete: if isAdmin() || (isJuniorHighStaff() && existing().reporterId == request.auth.uid);
      }
    }

    match /juniorhigh_mtss_academic_cases/{caseId} {
      allow read: if isActive() && isJuniorHighStaff();
      allow read: if isActive() && isLinkedStudent(existing().studentId);
      allow create: if isJuniorHighStaff() && isValidMTSSAcademicCase(incoming());
      allow update: if isAdmin() || isJuniorHighStaff();
      allow delete: if isAdmin();

      match /goals/{goalId} {
        allow read, write: if isJuniorHighStaff();
      }

      match /sessions/{sessionId} {
        allow read: if isJuniorHighStaff()
          || isLinkedStudent(get(/databases/$(database)/documents/juniorhigh_mtss_academic_cases/$(caseId)).data.studentId);
        allow write: if isJuniorHighStaff();
      }

      match /meetings/{meetingId} {
        allow read, write: if isJuniorHighStaff();
      }

      match /plans/{planId} {
        allow read, write: if isJuniorHighStaff();
      }

      match /evaluations/{evaluationId} {
        allow read: if isJuniorHighStaff()
          || isLinkedStudent(get(/databases/$(database)/documents/juniorhigh_mtss_academic_cases/$(caseId)).data.studentId);
        allow write: if isJuniorHighStaff();
      }

      match /parentDocuments/{docId} {
        allow read: if isJuniorHighStaff()
          || isLinkedStudent(get(/databases/$(database)/documents/juniorhigh_mtss_academic_cases/$(caseId)).data.studentId);
        allow write: if isJuniorHighStaff();
      }

      match /audits/{auditId} {
        allow read, create: if isJuniorHighStaff();
      }
    }

    match /juniorhigh_mtss_academic_alerts/{alertId} {
      allow read: if isJuniorHighStaff();
      allow write: if isJuniorHighStaff() && isValidMTSSAcademicAlert(incoming());
    }

    match /juniorhigh_mtss_academic_timeline/{phaseId} {
      allow read: if isJuniorHighStaff();
      allow write: if isMTSSAcademicManager();
    }

    match /juniorhigh_mtss_academic_documents/{docId} {
      allow read, write: if isJuniorHighStaff();
    }

    match /juniorhigh_mtss_academic_backup_config/{configId} {
      allow read: if isJuniorHighStaff();
      allow write: if isAdmin();
    }

    match /juniorhigh_mtss_tier1_assessments/{assessmentId} {
      allow read, write: if isJuniorHighStaff();
    }

    match /cicoSessions/{sessionId} {
      allow read: if isActive() && isJuniorHighStaff();
      allow read: if isActive() && isLinkedStudent(existing().studentId);
      allow write: if isJuniorHighStaff();
    }

    match /cicoGoalConfigs/{caseId} {
      allow read, write: if isActive() && isJuniorHighStaff();
    }

    match /bipPlans/{planId} {
      allow read: if isActive() && isJuniorHighStaff() && (userRole() in ['BK_MENTOR', 'HEAD_JUNIOR', 'SUPER_ADMIN']);
      allow write: if isAdmin() || (isActive() && userRole() in ['BK_MENTOR', 'HEAD_JUNIOR']);
    }

    match /reflections/{reflectionId} {
      allow read: if isActive() && isJuniorHighStaff();
      allow read: if isActive() && isStudent() && existing().studentId == request.auth.uid;
      allow read: if isActive() && isLinkedStudent(existing().studentId);
      allow create: if isStudent() || isJuniorHighStaff();
      allow update: if isAdmin() || (isStudent() && existing().studentId == request.auth.uid);
    }

    match /literacyProgress/{progressId} {
      allow read: if isActive() && isJuniorHighStaff();
      allow read: if isActive() && isLinkedStudent(existing().studentId);
      allow write: if isJuniorHighStaff();
    }

    match /junior_high_literacy_numeracy_records/{recordId} {
      allow read: if isActive() && isJuniorHighStaff();
      allow read: if isActive() && isLinkedStudent(existing().studentId);
      allow write: if isJuniorHighStaff();
    }

    match /cicoWeeklyReflections/{reflectionId} {
      allow read: if isActive() && isJuniorHighStaff();
      allow read: if isActive() && isLinkedStudent(existing().studentId);
      allow write: if isJuniorHighStaff();
    }

    match /elementary_mtss_cases/{caseId} {
      allow read: if isActive() && (isTeacher() || isAdmin() || isJuniorHighStaff() || isLinkedStudent(resource.data.studentId));
      allow write: if isTeacher() || isAdmin() || isJuniorHighStaff();

      match /coaching_sessions/{sessionId} {
        allow read: if isActive() && (isTeacher() || isAdmin() || isJuniorHighStaff() || isLinkedStudent(get(/databases/$(database)/documents/elementary_mtss_cases/$(caseId)).data.studentId));
        allow write: if isTeacher() || isAdmin() || isJuniorHighStaff();
      }
    }

    match /elementary_mtss_batch_sheets/{sheetId} {
      allow read, write: if isActive() && (isTeacher() || isAdmin() || isJuniorHighStaff());
    }

    match /elementary_literacy_numeracy/{recordId} {
      allow read: if isActive() && (isTeacher() || isAdmin() || isJuniorHighStaff() || isLinkedStudent(existing().studentId));
      allow write: if isTeacher() || isAdmin() || isJuniorHighStaff();
    }

    match /elementary_literacy_numeracy_records/{recordId} {
      allow read: if isActive() && (isTeacher() || isAdmin() || isJuniorHighStaff() || isLinkedStudent(existing().studentId));
      allow write: if isTeacher() || isAdmin() || isJuniorHighStaff();
    }

    match /selfExploration/{studentId} {
      allow read: if isActive() &&
        ((isStudent() && studentId == request.auth.uid) || isJuniorHighStaff() || isLinkedStudent(studentId));
      allow write: if isAdmin() || (isStudent() && studentId == request.auth.uid);
    }

    match /sePeriods/{periodId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isJuniorHighStaff();
    }

    match /seActivities/{activityId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isJuniorHighStaff();
    }

    match /seEnrollments/{enrollmentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /seSessionLogs/{logId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isJuniorHighStaff();
    }

    match /seSelfAssessments/{assessmentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /attendance/{attendanceId} {
      allow read: if isActive() && isTeacher();
      allow read: if isActive() && isJuniorHighStaff();
      allow read: if isAdmin();
      allow read: if isActive() && isLinkedStudent(existing().studentId);
      allow write: if isTeacher() || isJuniorHighStaff() || isAdmin();
    }

    match /attendance_records/{recordId} {
      allow read: if isActive() && isTeacher();
      allow read: if isActive() && isJuniorHighStaff();
      allow read: if isAdmin();
      allow read: if isActive() && isLinkedStudent(existing().studentId);
      allow write: if isTeacher() || isJuniorHighStaff() || isAdmin();
    }

    match /dhuhur_attendance_records/{recordId} {
      function isValidDhuhurCreate(recId) {
        return request.resource.data.id == recId
          && request.resource.data.studentId != null && request.resource.data.studentId != ""
          && request.resource.data.classId != null && request.resource.data.classId != ""
          && request.resource.data.date != null && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.unit == 'JUNIOR_HIGH'
          && request.resource.data.academicYearId != null && request.resource.data.academicYearId != ""
          && request.resource.data.academicYear != null && request.resource.data.academicYear != ""
          && request.resource.data.semester in ['1', '2']
          && request.resource.data.studentNameSnapshot != null && request.resource.data.studentNameSnapshot != ""
          && request.resource.data.classNameSnapshot != null && request.resource.data.classNameSnapshot != ""
          && request.resource.data.recordedByUid != null && request.resource.data.recordedByUid != ""
          && request.resource.data.recordedByEmail != null && request.resource.data.recordedByEmail != ""
          && request.resource.data.recordedAt != null
          && request.resource.data.backupType == 'DHUHUR_ATTENDANCE'
          && request.resource.data.status in ['H', 'T', 'A']
          && request.resource.data.updatedAt != null
          && request.resource.data.syncStatus in ['PENDING', 'SYNCED', 'FAILED']
          && request.resource.data.retryCount is int
          && recId == 'dhuhur_' + request.resource.data.classId + '_' + request.resource.data.date + '_' + request.resource.data.studentId;
      }

      function isValidDhuhurUpdate() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.classId == resource.data.classId
          && request.resource.data.date == resource.data.date
          && request.resource.data.unit == resource.data.unit
          && request.resource.data.academicYearId == resource.data.academicYearId
          && request.resource.data.academicYear == resource.data.academicYear
          && request.resource.data.semester == resource.data.semester
          && request.resource.data.studentNameSnapshot == resource.data.studentNameSnapshot
          && request.resource.data.classNameSnapshot == resource.data.classNameSnapshot
          && request.resource.data.recordedByUid == resource.data.recordedByUid
          && request.resource.data.recordedByEmail == resource.data.recordedByEmail
          && request.resource.data.recordedAt == resource.data.recordedAt
          && request.resource.data.backupType == resource.data.backupType
          && request.resource.data.status in ['H', 'T', 'A']
          && request.resource.data.updatedAt != null;
      }

      allow read: if isActive() && (isJuniorHighStaff() || isTeacher() || isAdmin());
      allow delete: if false;
      allow create: if isActive() && (isJuniorHighStaff() || isTeacher() || isAdmin()) && isValidDhuhurCreate(recordId);
      allow update: if isActive() && (isJuniorHighStaff() || isTeacher() || isAdmin()) && isValidDhuhurUpdate();
    }

    match /lateness_records/{recordId} {
      allow read: if isActive() && isTeacher();
      allow read: if isActive() && isJuniorHighStaff();
      allow read: if isAdmin();
      allow read: if isActive() && isLinkedStudent(existing().studentId);
      allow write: if isTeacher() || isJuniorHighStaff() || isAdmin();
    }

    match /system_backup_configs/{configId} {
      allow read: if isActive() || isAdmin();
      allow write: if isAdmin() || isJuniorHighStaff();
    }

    match /attendance_backup_file_maps/{mapId} {
      allow read: if isActive() || isAdmin();
      allow write: if isAdmin() || isJuniorHighStaff();
    }

    match /observations/{observationId} {
      allow read: if isActive() && isTeacher();
      allow read: if isActive() && isJuniorHighStaff();
      allow read: if isAdmin();
      allow read: if isActive() && isLinkedStudent(existing().studentId);
      allow write: if isTeacher() || isJuniorHighStaff() || isAdmin();
    }

    match /learning_goals/{goalId} {
      allow read, write: if isJuniorHighStaff();
    }

    match /lxd/{lxdId} {
      allow read, write: if isJuniorHighStaff();
    }

    match /assessments/{assessmentId} {
      allow read, write: if isJuniorHighStaff();
    }

    match /reportCards/{reportId} {
      allow get: if isSignedIn() &&
        (isJuniorHighStaff() || (isLinkedStudent(existing().studentId) && existing().status == "PUBLISHED"));

      allow list: if isJuniorHighStaff();

      allow write: if isJuniorHighStaff();
    }

    match /reportConfig/{unitId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isMTSSAcademicManager();
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn() && (existing().userId == request.auth.token.email || isAdmin());
      allow update: if isSignedIn()
        && existing().userId == request.auth.token.email
        && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
      allow create: if isSignedIn();
    }

    match /behavior_notifications/{notifId} {
      allow read: if isSignedIn() && (request.auth.uid in existing().targetUserIds || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        ((request.auth.uid in existing().targetUserIds
          && incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'isDismissed']))
          || isAdmin());
    }

    match /parentStudentLinks/{linkId} {
      allow get: if isSignedIn() && (
        isAdmin() || 
        (request.auth.token.email != null && (linkId == request.auth.token.email || linkId == request.auth.token.email.lower()))
      );
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        || (isSignedIn() && request.auth.token.email != null && (linkId == request.auth.token.email || linkId == request.auth.token.email.lower()));
      allow delete: if isAdmin();
    }

    match /parentReportViews/{viewId} {
      allow get: if isSignedIn() && (
        isAdmin() ||
        (
          'ownerEmail' in existing() &&
          existing().ownerEmail == request.auth.token.email
        )
      );

      allow list: if isAdmin();

      allow create: if isSignedIn() && (
        isAdmin() ||
        (
          'ownerEmail' in incoming() &&
          incoming().ownerEmail == request.auth.token.email
        )
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          'ownerEmail' in existing() &&
          existing().ownerEmail == request.auth.token.email
        )
      );

      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /clubs/{clubId} {
      allow read: if isSignedIn();
      allow write: if isJuniorHighStaff();
    }

    match /promptTemplates/{promptId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /knowledgeBase/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /published_kg_reports/{reportId} {
      allow read: if isActive() &&
        (isJuniorHighStaff() || isTeacher() || isLinkedStudent(existing().studentId));
      allow write: if isJuniorHighStaff() || isAdmin() || isTeacher();
    }

    match /weekly_summary_drafts/{draftId} {
      allow read, write: if (isActive() && (isJuniorHighStaff() || isTeacher())) || isAdmin();
    }

    match /ldssTemplates/{templateId} {
      allow read: if isActive() || isAdmin();
      allow write: if isAdmin() || (currentUserExists() && userRole() == 'HEAD_UNIT');
    }

    match /ldssAssessments/{assessmentId} {
      allow read, write: if isSignedIn() && (isActive() || isAdmin());
    }

    match /ldss_assessments/{assessmentId} {
      allow read, write: if isSignedIn() && (isActive() || isAdmin());
    }

    match /conferencePeriods/{periodId} {
      allow read: if isSignedIn() && isActive();
      allow write: if isAdmin();
    }

    match /studentConferenceResponses/{responseId} {
      allow get: if isActive() && isJuniorHighStaff();
      allow get: if isActive() && isStudent() && currentUserExists() && ('luminaId' in currentUser()) && responseId.split('_')[1] == currentUser().luminaId;
      allow get: if isActive() && resource != null && isLinkedStudent(resource.data.studentId);

      allow list: if isActive() && isJuniorHighStaff();
      allow list: if isActive() && isStudent() && currentUserExists() && ('luminaId' in currentUser()) && resource.data.studentId == currentUser().luminaId;
      allow list: if isActive() && isLinkedStudent(resource.data.studentId);
      allow create: if isActive() && (
        isJuniorHighStaff() ||
        (isOwnStudentData(incoming().studentId) && responseId.split('_')[1] == incoming().studentId)
      );
      allow update: if isActive() && (
        isJuniorHighStaff() ||
        (isOwnStudentData(existing().studentId) && incoming().studentId == existing().studentId)
      );
      allow delete: if isActive() && (
        isJuniorHighStaff() ||
        isOwnStudentData(existing().studentId)
      );
    }

    match /mentorAssignments/{assignmentId} {
      allow get: if isActive() && isJHConferenceStaff();
      allow get: if isActive() && isStudent() && currentUserExists() && ('luminaId' in currentUser()) && assignmentId.split('_')[1] == currentUser().luminaId;
      allow get: if isActive() && resource != null && isLinkedStudent(resource.data.studentId);

      allow list: if isActive() && isJHConferenceStaff();
      allow list: if isActive() && isStudent() && currentUserExists() && ('luminaId' in currentUser()) && resource.data.studentId == currentUser().luminaId;
      allow create: if isJHConferenceStaff() && 
        incoming().studentId is string && 
        incoming().periodId is string;
      allow update: if isJHConferenceStaff() && 
        incoming().studentId == existing().studentId && 
        incoming().periodId == existing().periodId;
    }

    match /smartGoalTrackerEntries/{entryId} {
      allow get: if isActive() && isJHConferenceStaff();
      allow get: if isActive() && resource != null && isOwnStudentData(resource.data.studentId);

      allow list: if isActive() && isJHConferenceStaff();
      allow list: if isActive() && isStudent() && currentUserExists() && ('luminaId' in currentUser()) && resource.data.studentId == currentUser().luminaId;
      allow create: if isActive() &&
        isOwnStudentData(incoming().studentId) &&
        incoming().keys().hasAll(['studentId', 'periodId', 'goalId', 'goalStrand', 'goalSnapshot']) &&
        !('mentorComment' in incoming()) &&
        !('commentedBy' in incoming()) &&
        !('commentedByName' in incoming()) &&
        !('commentedAt' in incoming());
      allow update: if isActive() && (
        (
          isOwnStudentData(existing().studentId) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'entryDate', 'actionsTaken', 'progressMade', 'hinderingBehaviors', 'improvementPlan', 'updatedAt'
          ])
        ) || (
          isJHConferenceStaff() &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'mentorComment', 'commentedBy', 'commentedByName', 'commentedAt', 'updatedAt'
          ])
        )
      );
      allow delete: if false;
    }
  }
}