    match /published_kg_reports/{reportId} {
      allow read: if isActive() &&
        (isJuniorHighStaff() || isTeacher() || isOwnStudentData(existing().studentId));
      allow create: if isJuniorHighStaff() || isAdmin() || isTeacher();
      allow update: if (isJuniorHighStaff() || isAdmin() || isTeacher()) ||
        (isActive() && isOwnStudentData(existing().studentId) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['studentViewedAt', 'lastStudentViewedAt', 'pdfOpenedAt', 'viewCount']));
      allow delete: if isJuniorHighStaff() || isAdmin() || isTeacher();
    }

    match /published_junior_high_monthly_reports/{reportId} {
      allow read: if isJuniorHighStaff() || isAdmin();
      allow create: if (isJuniorHighStaff() || isAdmin()) &&
        request.resource.data.unit == "JUNIOR_HIGH" &&
        request.resource.data.reportType == "MONTHLY_REPORT" &&
        request.resource.data.generatedBy == request.auth.uid &&
        request.resource.data.driveFolderId == "1mjxXJKaKSCfn0RNpJWQTsI65DwnhiyqK";
      allow update, delete: if false;
    }

    match /archived_kg_reports/{reportId} {
      allow read: if isActive() && (isJuniorHighStaff() || isTeacher() || isAdmin());
      allow create: if isActive() && (isJuniorHighStaff() || isTeacher() || isAdmin());
      allow update: if isActive() && (isJuniorHighStaff() || isTeacher() || isAdmin());
      allow delete: if isActive() && (isJuniorHighStaff() || isTeacher() || isAdmin());
    }

    match /weekly_summary_drafts/{draftId} {
      allow read, write: if (isActive() && (isJuniorHighStaff() || isTeacher())) || isAdmin();
    }

    match /ldssTemplates/{templateId} {
      allow read: if isActive() || isAdmin();
      allow write: if isAdmin() || (currentUserExists() && userRole() == 'HEAD_UNIT');
    }

    match /ldssAssessments/{assessmentId} {
      allow read, write: if isSignedIn() && (isActive() || isAdmin());
    }

    match /ldss_assessments/{assessmentId} {
