    function isKindergartenClass(classId) {
      return exists(/databases/$(database)/documents/classes/$(classId)) &&
        get(/databases/$(database)/documents/classes/$(classId)).data.unitId == 'KINDERGARTEN';
    }

    match /observations/{observationId} {
      allow read: if isActive() && (
        isTeacher() ||
        isJuniorHighStaff() ||
        (userRole() == 'kindergarten_subject_teacher' && currentUser().unitId == 'KINDERGARTEN')
      );
      allow read: if isAdmin();
      allow read: if isActive() && isLinkedStudent(existing().studentId);
      allow write: if isActive() && (
        isTeacher() ||
        isJuniorHighStaff() ||
        isAdmin() ||
        (userRole() == 'kindergarten_subject_teacher' && currentUser().unitId == 'KINDERGARTEN' && (
          (request.method == 'create' && isKindergartenClass(incoming().classId)) ||
          (request.method == 'update' && isKindergartenClass(existing().classId) && isKindergartenClass(incoming().classId)) ||
          (request.method == 'delete' && isKindergartenClass(existing().classId))
        ))
      );
    }

    match /kindergarten_observation_daily_contexts/{contextId} {
      allow read, write: if isActive() && (
        isTeacher() ||
        isJuniorHighStaff() ||
