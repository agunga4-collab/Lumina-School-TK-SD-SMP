    // Learning Power-Up spreadsheet tracker: private headers, own-row student reports.
    function isLpuTrackerReader() {
      return isActive() && (
        isAdmin() || (userRole() in [
          'TEACHER', 'HOMEROOM_TEACHER', 'HEAD_JUNIOR', 'HEAD_UNIT',
          'BK_MENTOR', 'MTSS_ACADEMIC_PJ', 'COUNSELOR', 'COORDINATOR',
          'SECRETARY_JH', 'PRINCIPAL', 'VICE_PRINCIPAL'
        ] && (
          ('unitId' in currentUser() && currentUser().unitId in ['JUNIOR_HIGH', 'ALL']) ||
          ('unit' in currentUser() && currentUser().unit in ['JUNIOR_HIGH', 'ALL'])
        ))
      );
    }
    function isLpuTrackerWriter() {
      return isLpuTrackerReader() && !(userRole() in ['PRINCIPAL', 'VICE_PRINCIPAL']);
    }
    function lpuTrackerParent(columnId) {
      return getAfter(/databases/$(database)/documents/lpu_tracker_columns/$(columnId)).data;
    }
    function isValidLpuTrackerColumn(data, columnId) {
      return data.keys().hasAll(['id', 'unit', 'academicYear', 'semester', 'subjectKey', 'label', 'periodLabel', 'order', 'valueType', 'studentIds', 'archived', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'version'])
        && data.keys().hasOnly(['id', 'unit', 'academicYear', 'semester', 'subjectKey', 'label', 'periodLabel', 'order', 'valueType', 'studentIds', 'archived', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'version'])
        && data.id == columnId && data.unit == 'JUNIOR_HIGH'
        && data.academicYear is string && data.academicYear.size() > 0
        && data.semester in ['1', '2']
        && data.subjectKey in ['bahasaIndonesia', 'english', 'mengaji', 'numerasi']
        && data.label is string && data.label.size() > 0 && data.label.size() <= 200
        && data.periodLabel is string && data.periodLabel.size() <= 200
        && data.order is number && data.valueType in ['FREE', 'NUMBER']
        && data.studentIds is list && data.studentIds.size() > 0 && data.studentIds.size() <= 400
        && data.archived is bool && data.createdBy is string && data.createdAt is number
        && data.updatedBy == request.auth.uid && data.updatedAt is number && data.version is int;
    }
    function isValidLpuTrackerCell(data, cellId) {
      let parent = lpuTrackerParent(data.columnId);
      return data.keys().hasAll(['id', 'unit', 'academicYear', 'semester', 'subjectKey', 'columnId', 'studentId', 'studentName', 'classId', 'className', 'label', 'periodLabel', 'order', 'valueType', 'visible', 'value', 'valueVersion', 'valueUpdatedAt', 'valueUpdatedBy', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['id', 'unit', 'academicYear', 'semester', 'subjectKey', 'columnId', 'studentId', 'studentName', 'classId', 'className', 'label', 'periodLabel', 'order', 'valueType', 'visible', 'value', 'valueVersion', 'valueUpdatedAt', 'valueUpdatedBy', 'updatedBy', 'updatedAt'])
        && data.id == cellId && data.unit == 'JUNIOR_HIGH'
        && data.columnId is string && data.studentId is string && data.studentId.size() > 0
        && data.studentName is string && data.classId is string && data.className is string
        && data.academicYear == parent.academicYear && data.semester == parent.semester
        && data.subjectKey == parent.subjectKey && parent.unit == 'JUNIOR_HIGH'
        && data.label == parent.label && data.periodLabel == parent.periodLabel
        && data.order == parent.order && data.valueType == parent.valueType
        && data.visible is bool && data.visible == (!parent.archived && data.studentId in parent.studentIds)
        && ((data.value is string && data.value.size() <= 5000) || data.value is number)
        && (data.valueType != 'NUMBER' || data.value == '' || data.value is number)
        && data.valueVersion is int && data.valueVersion >= 0
        && data.valueUpdatedAt is number && data.valueUpdatedBy is string
        && data.updatedAt is number && data.updatedBy == request.auth.uid;
    }
    match /lpu_tracker_columns/{columnId} {
      allow read: if isLpuTrackerReader();
      allow create: if isLpuTrackerWriter() && isValidLpuTrackerColumn(incoming(), columnId)
        && incoming().createdBy == request.auth.uid && incoming().version == 1;
      allow update: if isLpuTrackerWriter() && isValidLpuTrackerColumn(incoming(), columnId)
        && incoming().academicYear == existing().academicYear && incoming().semester == existing().semester
        && incoming().subjectKey == existing().subjectKey && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt && incoming().version == existing().version + 1;
      allow delete: if false;
    }
    match /lpu_tracker_cells/{cellId} {
      allow read: if isLpuTrackerReader() || (isActive() && isOwnStudentData(existing().studentId) && existing().visible == true);
      allow create: if isLpuTrackerWriter() && isValidLpuTrackerCell(incoming(), cellId)
        && incoming().value == '' && incoming().valueVersion == 0
        && incoming().valueUpdatedAt == 0 && incoming().valueUpdatedBy == '';
      allow update: if isLpuTrackerWriter() && isValidLpuTrackerCell(incoming(), cellId)
        && incoming().studentId == existing().studentId && incoming().classId == existing().classId
        && incoming().academicYear == existing().academicYear && incoming().semester == existing().semester
        && incoming().subjectKey == existing().subjectKey && incoming().columnId == existing().columnId
        && (
          (incoming().diff(existing()).affectedKeys().hasOnly(['value', 'valueVersion', 'valueUpdatedAt', 'valueUpdatedBy', 'updatedBy', 'updatedAt'])
            && incoming().valueVersion == existing().valueVersion + 1 && incoming().valueUpdatedBy == request.auth.uid)
          || (incoming().diff(existing()).affectedKeys().hasOnly(['studentName', 'className', 'label', 'periodLabel', 'order', 'valueType', 'visible', 'updatedBy', 'updatedAt'])
            && incoming().value == existing().value && incoming().valueVersion == existing().valueVersion)
        );
      allow delete: if false;
    }
    function isValidLpuTrackerCoach(data, recordId) {
      return data.keys().hasAll(['id', 'unit', 'academicYear', 'semester', 'studentId', 'classId', 'coachId', 'coachName', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['id', 'unit', 'academicYear', 'semester', 'studentId', 'classId', 'coachId', 'coachName', 'updatedBy', 'updatedAt'])
        && data.id == recordId && data.unit == 'JUNIOR_HIGH' && data.academicYear is string
        && data.semester in ['1', '2'] && data.studentId is string && data.classId is string
        && data.coachId is string && data.coachName is string && data.updatedBy == request.auth.uid && data.updatedAt is number
        && ((data.coachId == '' && data.coachName == '') || (
          exists(/databases/$(database)/documents/users/$(data.coachId))
          && get(/databases/$(database)/documents/users/$(data.coachId)).data.status == 'active'
          && get(/databases/$(database)/documents/users/$(data.coachId)).data.role in ['TEACHER', 'HOMEROOM_TEACHER']
          && (
            ('unitId' in get(/databases/$(database)/documents/users/$(data.coachId)).data && get(/databases/$(database)/documents/users/$(data.coachId)).data.unitId in ['JUNIOR_HIGH', 'ALL'])
            || ('unit' in get(/databases/$(database)/documents/users/$(data.coachId)).data && get(/databases/$(database)/documents/users/$(data.coachId)).data.unit in ['JUNIOR_HIGH', 'ALL'])
          )
        ));
    }
    match /lpu_tracker_coaches/{recordId} {
      allow read: if isLpuTrackerReader() || (isActive() && isOwnStudentData(existing().studentId));
      allow create: if isLpuTrackerWriter() && isValidLpuTrackerCoach(incoming(), recordId);
      allow update: if isLpuTrackerWriter() && isValidLpuTrackerCoach(incoming(), recordId)
        && incoming().studentId == existing().studentId && incoming().academicYear == existing().academicYear
        && incoming().semester == existing().semester;
      allow delete: if false;
    }


    // Assessment Book shared tasks retained from the prior correction package.
    match /jh_ab_shared_tasks/{taskId} {
      allow read: if isActive() && isJuniorHighStaff();
      allow create: if isActive() && (isAdmin() || isJuniorHighTeacher() || (userRole() in ['HEAD_UNIT', 'HEAD_JUNIOR'] && isJuniorHighStaffAuthorized()))
        && incoming().keys().hasAll(['id', 'loId', 'lgId', 'classId', 'sourceLoClassId', 'subjectId', 'academicYear', 'semester', 'date', 'formativeTask', 'studentIds', 'teacherId', 'teacherName', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['id', 'loId', 'lgId', 'classId', 'sourceLoClassId', 'subjectId', 'academicYear', 'semester', 'date', 'formativeTask', 'studentIds', 'teacherId', 'teacherName', 'createdAt', 'updatedAt', 'assessmentMode', 'unitActivityId', 'unitActivityName', 'unitActivityCategory', 'assessmentGroupId', 'targetGrade'])
        && incoming().id == taskId && incoming().loId is string && incoming().teacherId == request.auth.uid
        && incoming().teacherName is string && incoming().formativeTask is string && incoming().formativeTask.size() > 0 && incoming().formativeTask.size() <= 2000
        && incoming().date is string && incoming().date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && incoming().studentIds is list && incoming().studentIds.size() > 0 && incoming().studentIds.size() <= 400
        && incoming().createdAt is number && incoming().updatedAt == incoming().createdAt
        && exists(/databases/$(database)/documents/jh_ab_los/$(incoming().loId))
        && incoming().lgId == get(/databases/$(database)/documents/jh_ab_los/$(incoming().loId)).data.lgId
        && incoming().subjectId == get(/databases/$(database)/documents/jh_ab_los/$(incoming().loId)).data.subjectId
        && incoming().academicYear == get(/databases/$(database)/documents/jh_ab_los/$(incoming().loId)).data.academicYear
        && incoming().semester == get(/databases/$(database)/documents/jh_ab_los/$(incoming().loId)).data.semester
        && incoming().sourceLoClassId == get(/databases/$(database)/documents/jh_ab_los/$(incoming().loId)).data.classId
        && (
          (!('assessmentMode' in incoming()) && incoming().classId == incoming().sourceLoClassId
            && (!('assessmentMode' in get(/databases/$(database)/documents/jh_ab_los/$(incoming().loId)).data)
              || get(/databases/$(database)/documents/jh_ab_los/$(incoming().loId)).data.assessmentMode != 'UNIT_ACTIVITY'))
          || (incoming().assessmentMode == 'UNIT_ACTIVITY'
            && get(/databases/$(database)/documents/jh_ab_los/$(incoming().loId)).data.assessmentMode == 'UNIT_ACTIVITY'
            && incoming().unitActivityId == get(/databases/$(database)/documents/jh_ab_los/$(incoming().loId)).data.unitActivityId
            && incoming().unitActivityName == get(/databases/$(database)/documents/jh_ab_los/$(incoming().loId)).data.unitActivityName
            && incoming().unitActivityCategory == get(/databases/$(database)/documents/jh_ab_los/$(incoming().loId)).data.unitActivityCategory
            && incoming().targetGrade == 'ALL' && incoming().classId == incoming().assessmentGroupId
            && incoming().assessmentGroupId is string && incoming().assessmentGroupId.matches('JUNIOR_HIGH_UA_V2_.*~ALL'))
        );
      allow update, delete: if false;
    }

    // Junior High Assessment Book Rules (Fase 1)
    match /jh_ab_los/{loId} {
      allow read: if isActive() && isJuniorHighStaff();
      allow create: if isActive() && (
        isAdmin() ||
        (userRole() in ['HEAD_UNIT', 'HEAD_JUNIOR'] && isJuniorHighStaffAuthorized()) ||
        (userRole() in ['TEACHER', 'HOMEROOM_TEACHER'] && isJuniorHighTeacher() && isJuniorHighClassId(request.resource.data.classId))
      );
      allow update: if isActive() && (
        isAdmin() ||
        (userRole() in ['HEAD_UNIT', 'HEAD_JUNIOR'] && isJuniorHighStaffAuthorized()) ||
        (userRole() in ['TEACHER', 'HOMEROOM_TEACHER'] && isJuniorHighTeacher() && isJuniorHighClassId(resource.data.classId))
      ) &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'title', 'code', 'order', 'isActive', 'updatedAt'
      ]);
      allow delete: if isActive() && isAdmin();
    }

    match /jh_ab_formative_entries/{entryId} {
      allow read: if isActive() && isJuniorHighStaff();
      allow create: if isActive() &&
        request.resource.data.teacherId == request.auth.uid &&
        (
          isAdmin() ||
          (userRole() in ['HEAD_UNIT', 'HEAD_JUNIOR'] && isJuniorHighStaffAuthorized()) ||
          (userRole() in ['TEACHER', 'HOMEROOM_TEACHER'] && isJuniorHighTeacher() && isJuniorHighClassId(request.resource.data.classId))
        ) &&
        request.resource.data.comprehensionLevel in ['Achieved', 'Not Achieved', 'B', 'D', 'A'];
      allow update: if isActive() &&
        request.resource.data.comprehensionLevel in ['Achieved', 'Not Achieved', 'B', 'D', 'A'] &&
        (
          resource.data.teacherId == request.auth.uid ||
          isAdmin() ||
          (userRole() in ['HEAD_UNIT', 'HEAD_JUNIOR'] && isJuniorHighStaffAuthorized())
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'comprehensionLevel', 'formativeTask', 'nextAction', 'notes',
          'date', 'updatedAt', 'correctedAt', 'correctedBy', 'correctedByName', 'correctionReason'
        ]);
      allow delete: if isActive() && isAdmin();
    }

    match /jh_ab_summative_entries/{entryId} {
      allow read: if isActive() && isJuniorHighStaff();
      allow create: if isActive() &&
        (
          isAdmin() ||
          (userRole() in ['HEAD_UNIT', 'HEAD_JUNIOR'] && isJuniorHighStaffAuthorized()) ||
          (userRole() in ['TEACHER', 'HOMEROOM_TEACHER'] && isJuniorHighTeacher() && isJuniorHighClassId(request.resource.data.classId))
        ) &&
        request.resource.data.summativeScore in ['B', 'D', 'A'];
      allow update: if isActive() &&
        (
          isAdmin() ||
          (userRole() in ['HEAD_UNIT', 'HEAD_JUNIOR'] && isJuniorHighStaffAuthorized()) ||
          (userRole() in ['TEACHER', 'HOMEROOM_TEACHER'] && isJuniorHighTeacher() && isJuniorHighClassId(resource.data.classId))
        ) &&
        request.resource.data.summativeScore in ['B', 'D', 'A'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'summativeTask', 'summativeScore', 'notes', 'date', 'updatedAt', 'updatedBy', 'updatedByName'
        ]);
      allow delete: if isActive() && isAdmin();
    }

    match /jh_ab_sheet_sources/{sourceId} {
      allow read: if isActive() && (isJuniorHighStaff() || isAdmin());
      allow create, update: if isActive() && (
        isAdmin() ||
        (userRole() in ['HEAD_UNIT', 'HEAD_JUNIOR'] && isJuniorHighStaffAuthorized()) ||
        (userRole() in ['TEACHER', 'HOMEROOM_TEACHER'] && isJuniorHighTeacher())
      );
      allow delete: if isActive() && (
        isAdmin() ||
        (userRole() in ['HEAD_UNIT', 'HEAD_JUNIOR'] && isJuniorHighStaffAuthorized()) ||
        (userRole() in ['TEACHER', 'HOMEROOM_TEACHER'] && resource.data.createdBy == request.auth.uid)
      );
    }

    match /jh_ab_sheet_sync_logs/{logId} {
      allow read: if isActive() && (isJuniorHighStaff() || isAdmin());
      allow create: if isActive() && (
        isAdmin() ||
        (userRole() in ['HEAD_UNIT', 'HEAD_JUNIOR'] && isJuniorHighStaffAuthorized()) ||
        (userRole() in ['TEACHER', 'HOMEROOM_TEACHER'] && isJuniorHighTeacher())
      );
      allow update, delete: if false;
    }

    match /elem_midterm_master_goals/{goalId} {
      allow read, write: if isElementaryStaff();
    }

    match /elem_midterm_period_configs/{configId} {
      allow read: if isActive() && isElementaryStaff();

      allow create, update: if isActive() && (
        isAdmin() ||
        isElementaryHeadUnitOrPrincipal() ||
        (userRole() in ['COORDINATOR', 'SECRETARY_ELEM'] && (
          !('unitId' in currentUser()) || currentUser().unitId == 'ELEMENTARY' || currentUser().unitId == 'ALL' ||
          ('unit' in currentUser() && (currentUser().unit == 'ELEMENTARY' || currentUser().unit == 'ALL'))
        ))
      );

      allow delete: if isAdmin();
    }

    match /elem_midterm_student_data/{dataId} {
      allow read: if isActive() && (
        isElementaryStaff() ||
        (resource != null && isOwnStudentData(resource.data.studentId)) ||
        (resource != null && isLinkedStudent(resource.data.studentId))
      );

      allow create, update: if isElementaryStaff();

      allow delete: if isAdmin() || isElementaryHeadUnitOrPrincipal();
    }

    match /elem_midterm_class_comments_config/{configId} {
      allow read, write: if isElementaryStaff();
    }

    match /elem_midterm_published_reports/{reportId} {
      allow read: if isActive() && (
        isElementaryStaff() ||
        (resource != null && isOwnStudentData(resource.data.studentId)) ||
        (resource != null && isLinkedStudent(resource.data.studentId))
      );

      allow create, update: if isElementaryStaff();

      allow delete: if isAdmin() || isElementaryHeadUnitOrPrincipal();
    }

    match /elem_midterm_delivery_tracking/{trackingId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isElementaryHeadUnitOrPrincipal() ||
        isSecretaryElem() ||
        (isTeacher() && (currentUser().unitId == 'ELEMENTARY' || currentUser().unitId == 'ALL' || (resource != null && isTeacherAssignedToClass(resource.data.classId)))) ||
        (resource != null && (
          (isStudent() && ('studentUid' in resource.data) && resource.data.studentUid == request.auth.uid) ||
          (isStudent() && ('studentAccountId' in resource.data) && resource.data.studentAccountId == request.auth.uid) ||
          isOwnStudentData(resource.data.studentId) ||
          isLinkedStudent(resource.data.studentId)
        ))
      );

      allow create: if isSignedIn() && (
        isAdmin() ||
        isElementaryHeadUnitOrPrincipal() ||
        isSecretaryElem() ||
        (isTeacher() && isTeacherAssignedToClass(request.resource.data.classId))
      );

      allow update: if isSignedIn() && (
        isAdmin() ||
        isElementaryHeadUnitOrPrincipal() ||
        isSecretaryElem() ||
        (isTeacher() && isTeacherAssignedToClass(request.resource.data.classId)) ||
        (
          isStudent() &&
          resource != null &&
          (
            ('studentUid' in resource.data && resource.data.studentUid == request.auth.uid) ||
            ('studentAccountId' in resource.data && resource.data.studentAccountId == request.auth.uid) ||
            isOwnStudentData(resource.data.studentId)
          ) &&
          request.resource.data.studentId == resource.data.studentId &&
          (!('studentUid' in resource.data) || request.resource.data.studentUid == resource.data.studentUid) &&
          (!('studentAccountId' in resource.data) || request.resource.data.studentAccountId == resource.data.studentAccountId) &&
          (!('unit' in resource.data) || request.resource.data.unit == resource.data.unit) &&
          (!('activePdfUrl' in resource.data) || request.resource.data.activePdfUrl == resource.data.activePdfUrl) &&
          (!('pdfUrl' in resource.data) || request.resource.data.pdfUrl == resource.data.pdfUrl) &&
          (!('reportVersion' in resource.data) || request.resource.data.reportVersion == resource.data.reportVersion) &&
          (!('activeReportId' in resource.data) || request.resource.data.activeReportId == resource.data.activeReportId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'deliveryStatus', 'firstOpenedAt', 'lastOpenedAt', 'openCount', 'openedByEmail', 'updatedAt', 'history', 'firstViewedAt', 'lastViewedAt', 'viewCount'
          ])
        )
      );

      allow delete: if isAdmin() || isElementaryHeadUnitOrPrincipal();
    }

    match /elem_sn_students/{docId} {
      allow read: if isActive() && isElementaryStaff();
      allow create, update, delete: if isActive() && (isAdmin() || isElementaryHeadUnitOrPrincipal());
    }

    match /elem_sn_midterm_reports/{reportId} {
      allow read: if isActive() && isElementaryStaff();
      allow create, update: if isActive() && isElementaryStaff();
      allow delete: if isActive() && (isAdmin() || isElementaryHeadUnitOrPrincipal());
    }

    match /elem_sn_midterm_published_reports/{reportId} {
      allow read: if isActive() && (
        isElementaryStaff() ||
        (resource != null && (isOwnStudentData(resource.data.studentId) || isLinkedStudent(resource.data.studentId)))
      );
      allow create, update: if isActive() && isElementaryStaff();
      allow delete: if isActive() && isAdmin();
    }

    match /unit_activity_enrollments/{enrollmentId} {
      allow read: if isActive();
      allow write: if isElementaryStaff() || isJuniorHighStaff() || isAdmin();
    }

    match /archived_kg_reports/{reportId} {
      allow read: if isActive() && (isJuniorHighStaff() || isTeacher() || isSecretaryKindy() || isAdmin());
      allow create: if isActive() && (isJuniorHighStaff() || isTeacher() || isSecretaryKindy() || isAdmin());
      allow update: if isActive() && (isJuniorHighStaff() || isTeacher() || isSecretaryKindy() || isAdmin());
      allow delete: if isActive() && (isJuniorHighStaff() || isTeacher() || isSecretaryKindy() || isAdmin());
    }

    match /weekly_summary_drafts/{draftId} {
      allow read, write: if (isActive() && (isJuniorHighStaff() || isTeacher() || isSecretaryKindy() || isSecretaryElem() || isSecretaryJH())) || isAdmin();
    }

    match /midterm_summary_drafts/{draftId} {
      allow read: if isActive() && (
        isAdmin() ||
        isKindergartenHeadUnit() ||
        isSecretaryKindy() ||
        (isTeacher() && (resource == null || currentUser().unitId == 'KINDERGARTEN' || currentUser().unitId == 'ALL' || isTeacherAssignedToClass(resource.data.classId)))
      );
      allow create: if isActive() && (
        isAdmin() ||
        isKindergartenHeadUnit() ||
        isSecretaryKindy() ||
        (isTeacher() && 
          isTeacherAssignedToClass(incoming().classId) && 
          isStudentInClass(incoming().studentId, incoming().classId) &&
          incoming().unit == 'KINDERGARTEN' &&
          incoming().reportType == 'KINDY_MIDTERM_REPORT'
        )
      );
      allow update: if isActive() && (
        isAdmin() ||
        isKindergartenHeadUnit() ||
        isSecretaryKindy() ||
        (isTeacher() && 
          isTeacherAssignedToClass(incoming().classId) && 
          isMidtermIdentityUnchanged() &&
          (
            (existing().status in ['DRAFT', 'READY_FOR_REVIEW', 'SUBMITTED_FOR_REVIEW', 'PERLU_REVISI', 'APPROVED'] && incoming().status in ['DRAFT', 'READY_FOR_REVIEW', 'SUBMITTED_FOR_REVIEW']) ||
            (existing().status in ['APPROVED', 'PUBLISHED'] && incoming().status == 'PUBLISHED')
          )
        )
      );
      allow delete: if isActive() && (
        isAdmin() ||
        isKindergartenHeadUnit() ||
        isSecretaryKindy()
      );
    }

    match /midterm_summary_history/{logId} {
      allow read: if isActive() && (
        isAdmin() ||
        isKindergartenHeadUnit() ||
        isSecretaryKindy() ||
        (isTeacher() && (resource == null || currentUser().unitId == 'KINDERGARTEN' || currentUser().unitId == 'ALL' || isTeacherAssignedToClass(resource.data.classId)))
      );
      allow create: if isActive() && (
        isAdmin() ||
        isKindergartenHeadUnit() ||
        isSecretaryKindy() ||
        (isTeacher() && (currentUser().unitId == 'KINDERGARTEN' || currentUser().unitId == 'ALL' || isTeacherAssignedToClass(incoming().classId)))
      );
      allow update, delete: if false;
    }

    match /kindy_midterm_class_learning_goals/{documentId} {
      allow read: if isActive() && (
        isAdmin() ||
        isKindergartenHeadUnit() ||
        isSecretaryKindy() ||
        (isTeacher() && (isTeacherAssignedToClass(resource.data.classId) || (currentUser().unitId == 'KINDERGARTEN' || currentUser().unitId == 'ALL')))
      );
      allow create: if isActive() && (
        isAdmin() ||
        isKindergartenHeadUnit() ||
        isSecretaryKindy() ||
        (isTeacher() && (isTeacherAssignedToClass(incoming().classId) || (currentUser().unitId == 'KINDERGARTEN' || currentUser().unitId == 'ALL')))
      ) && isValidClassLearningGoals(incoming());
      allow update: if isActive() && (
        isAdmin() ||
        isKindergartenHeadUnit() ||
        isSecretaryKindy() ||
        (isTeacher() && (
          isTeacherAssignedToClass(existing().classId) || (currentUser().unitId == 'KINDERGARTEN' || currentUser().unitId == 'ALL')
        ))
      ) && (
        (isValidClassLearningGoals(incoming()) && (
          incoming().classId == existing().classId &&
          incoming().academicYear == existing().academicYear &&
          incoming().semester == existing().semester &&
          incoming().midtermPeriodKey == existing().midtermPeriodKey &&
          incoming().createdAt == existing().createdAt &&
          incoming().createdBy == existing().createdBy
        )) ||
        (incoming().diff(existing()).affectedKeys().hasOnly([
          'signingLocation', 'signingDate', 'updatedAt', 'updatedBy'
        ]) && (
          (!('signingDate' in incoming()) || incoming().signingDate is string) &&
          (!('signingLocation' in incoming()) || incoming().signingLocation is string) &&
          incoming().updatedAt is int &&
          incoming().updatedBy is string
        ))
      );
    }

    match /midterm_folders/{folderId} {
      allow read: if isActive() && (
        isAdmin() ||
        isKindergartenHeadUnit() ||
        isSecretaryKindy() ||
        isTeacher()
      );

      allow create, update: if isActive() && (
        isAdmin() ||
        isKindergartenHeadUnit() ||
        isSecretaryKindy() ||
        (isTeacher() && isTeacherAssignedToClass(folderId))
      );

      allow delete: if isAdmin();
    }

    match /ldssTemplates/{templateId} {
      allow read: if isActive() || isAdmin();
      allow write: if isAdmin() || (currentUserExists() && userRole() == 'HEAD_UNIT');
    }

    match /ldssAssessments/{assessmentId} {
      allow read, write: if isSignedIn() && (isActive() || isAdmin());
    }

    match /ldss_assessments/{assessmentId} {
      allow read, write: if isSignedIn() && (isActive() || isAdmin());
    }

    match /conferencePeriods/{periodId} {
      allow read: if isSignedIn() && isActive();
      allow write: if isAdmin();
    }

    match /studentConferenceResponses/{responseId} {
      allow get: if isActive() && isJuniorHighStaff();
      allow get: if isActive() && isStudent() && currentUserExists() && ('luminaId' in currentUser()) && (responseId.split('_')[responseId.split('_').size() - 1] == currentUser().luminaId || (resource != null && resource.data.studentId == currentUser().luminaId));
      allow get: if isActive() && resource != null && isLinkedStudent(resource.data.studentId);

      allow list: if isActive() && isJuniorHighStaff();
      allow list: if isActive() && isStudent() && currentUserExists() && ('luminaId' in currentUser()) && resource.data.studentId == currentUser().luminaId;
      allow list: if isActive() && isLinkedStudent(resource.data.studentId);
      allow create: if isActive() && (
        isJuniorHighStaff() ||
        (
          isOwnStudentData(incoming().studentId) &&
          responseId.split('_')[responseId.split('_').size() - 1] == incoming().studentId &&
          (!('sectionReviews' in incoming()) || incoming().sectionReviews == null) &&
          (!('overallStatus' in incoming()) || incoming().overallStatus in ['DRAFT', 'SUBMITTED'])
        )
      );
      allow update: if isActive() && (
        isJuniorHighStaff() ||
        (
          isOwnStudentData(existing().studentId) &&
          incoming().studentId == existing().studentId &&
          (
            !incoming().diff(existing()).affectedKeys().hasAny(['sectionReviews', 'overallStatus']) ||
            (
              (!('sectionReviews' in incoming()) || incoming().sectionReviews == null) &&
              (!('sectionReviews' in existing()) || existing().sectionReviews == null) &&
              (!('overallStatus' in incoming()) || incoming().overallStatus == 'DRAFT') &&
              (!('overallStatus' in existing()) || existing().overallStatus == 'DRAFT')
            )
          )
        )
      );
      allow delete: if isActive() && (
        isJuniorHighStaff() ||
        isOwnStudentData(existing().studentId)
      );
    }

    match /mentorAssignments/{assignmentId} {
      allow get: if isActive() && isJHConferenceStaff();
      allow get: if isActive() && isStudent() && currentUserExists() && ('luminaId' in currentUser()) && (assignmentId.split('_')[assignmentId.split('_').size() - 1] == currentUser().luminaId || (resource != null && resource.data.studentId == currentUser().luminaId));
      allow get: if isActive() && resource != null && isLinkedStudent(resource.data.studentId);

      allow list: if isActive() && isJHConferenceStaff();
      allow list: if isActive() && isStudent() && currentUserExists() && ('luminaId' in currentUser()) && resource.data.studentId == currentUser().luminaId;
      allow create: if isJHConferenceStaff() && 
        incoming().studentId is string && 
        incoming().periodId is string &&
        incoming().unit == 'JUNIOR_HIGH';
      allow update: if isJHConferenceStaff() && 
        incoming().studentId == existing().studentId && 
        incoming().periodId == existing().periodId &&
        (!('unit' in existing()) || existing().unit == 'JUNIOR_HIGH');
    }

    match /mentorAssignmentAudits/{auditId} {
      allow read: if isActive() && isJHConferenceStaff();
      allow create: if isActive() && isJHConferenceStaff() && 
        incoming().unit == 'JUNIOR_HIGH';
    }

    match /smartGoalTrackerEntries/{entryId} {
      allow get: if isActive() && isJHConferenceStaff();
      allow get: if isActive() && resource != null && isOwnStudentData(resource.data.studentId);

      allow list: if isActive() && isJHConferenceStaff();
      allow list: if isActive() && isStudent() && currentUserExists() && ('luminaId' in currentUser()) && resource.data.studentId == currentUser().luminaId;
      allow create: if isActive() &&
        isOwnStudentData(incoming().studentId) &&
        incoming().keys().hasAll(['studentId', 'periodId', 'goalId', 'goalStrand', 'goalSnapshot']);
      allow update: if isActive() && (
        (
          isOwnStudentData(existing().studentId) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'entryDate', 'actionsTaken', 'progressMade', 'hinderingBehaviors', 'improvementPlan', 'updatedAt',
            'overallStatus', 'submittedAt', 'lastSubmittedAt', 'revisionRound', 'editingStartedAt', 'lastActiveAt',
            'goalStrand', 'goalSnapshot', 'assignedMentorId', 'assignedMentorName'
          ]) &&
          !incoming().diff(existing()).affectedKeys().hasAny([
            'sectionReviews', 'mentorComment', 'commentedBy', 'commentedByName', 'commentedAt'
          ])
        ) || (
          isJHConferenceStaff() &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'mentorComment', 'commentedBy', 'commentedByName', 'commentedAt', 'updatedAt',
            'overallStatus', 'sectionReviews'
          ])
        )
      );
      allow delete: if false;
    }

    match /class_anecdotes/{anecdoteId} {
      allow read: if isActive() && (
        isAdmin() ||
        (currentUser().role == 'HEAD_UNIT' && (currentUser().unitId == 'ELEMENTARY' || currentUser().unitId == 'ALL')) ||
        isSecretaryElem() ||
        (isTeacher() && (currentUser().unitId == 'ELEMENTARY' || currentUser().unitId == 'ALL'))
      );
      
      allow create: if isActive() && (
        isAdmin() ||
        (currentUser().role == 'HEAD_UNIT' && (currentUser().unitId == 'ELEMENTARY' || currentUser().unitId == 'ALL')) ||
        isSecretaryElemClassAccess(incoming().classId) ||
        (isTeacher() && (currentUser().unitId == 'ELEMENTARY' || currentUser().unitId == 'ALL'))
      ) && isValidClassAnecdote(incoming());
      
      allow update: if isActive() && (
        isAdmin() ||
        (currentUser().role == 'HEAD_UNIT' && (currentUser().unitId == 'ELEMENTARY' || currentUser().unitId == 'ALL')) ||
        isSecretaryElemClassAccess(incoming().classId) ||
        (isTeacher() && (currentUser().unitId == 'ELEMENTARY' || currentUser().unitId == 'ALL'))
      ) && isValidClassAnecdoteUpdate(incoming())
        && incoming().studentId == existing().studentId
        && incoming().classId == existing().classId
        && (incoming().createdBy.uid == existing().createdBy.uid || isAdmin() || (currentUser().role == 'HEAD_UNIT' && (currentUser().unitId == 'ELEMENTARY' || currentUser().unitId == 'ALL')))
        && incoming().createdAt == existing().createdAt
        && incoming().academicYearId == existing().academicYearId;
        
      allow delete: if isActive() && (
        isAdmin() ||
        (currentUser().role == 'HEAD_UNIT' && (currentUser().unitId == 'ELEMENTARY' || currentUser().unitId == 'ALL')) ||
        isSecretaryElemClassAccess(existing().classId) ||
        (isTeacher() && (currentUser().unitId == 'ELEMENTARY' || currentUser().unitId == 'ALL') && existing().createdBy.uid == request.auth.uid)
      );
    }

    match /junior_high_unit_activity_enrollments/{enrollmentId} {
      allow read: if isActive() && (
        isJuniorHighStaff() ||
        isAdmin() ||
        isOwnStudentData(resource.data.studentId) ||
        isLinkedStudent(resource.data.studentId)
      );

      allow create: if (isJuniorHighStaff() || isAdmin()) &&
        incoming().unit == 'JUNIOR_HIGH' &&
        incoming().studentId != null && incoming().studentId != "" &&
        incoming().classId != null && incoming().classId != "" &&
        incoming().activityId != null && incoming().activityId != "" &&
        incoming().academicYear != null && incoming().academicYear != "" &&
        incoming().semester != null;

      allow update: if (isJuniorHighStaff() || isAdmin()) &&
        incoming().unit == 'JUNIOR_HIGH';
    }

    match /junior_high_unit_activity_semester_summaries/{summaryId} {
      allow read: if isActive() && (
        isJuniorHighStaff() ||
        isAdmin() ||
        isStudent() ||
        isParent()
      );

      allow create, update: if isActive() && (isJuniorHighStaff() || isAdmin()) &&
        incoming().unit == 'JUNIOR_HIGH';

      allow delete: if isActive() && (isJuniorHighStaff() || isAdmin());
    }

    match /junior_high_unit_activity_import_batches/{batchId} {
      allow read: if isActive() && (isJuniorHighStaff() || isAdmin());

      allow create, update: if (isJuniorHighStaff() || isAdmin()) &&
        incoming().unit == 'JUNIOR_HIGH';
    }

    match /attendance_calendar/{eventId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /class_report_summaries/{summaryId} {
      allow read: if isActive() && (isJuniorHighStaff() || isAdmin());
      allow write: if isActive() && (isJuniorHighStaff() || isAdmin()) &&
        incoming().unit == 'JUNIOR_HIGH' &&
        incoming().reportType == 'MONTHLY_PROGRESS';
    }

    match /junior_high_monthly_report_comments/{commentId} {
      allow read: if isActive() && (isJuniorHighStaff() || isAdmin());
      allow write: if isActive() && (isJuniorHighStaff() || isAdmin()) &&
        incoming().unit == 'JUNIOR_HIGH' &&
        incoming().reportType == 'MONTHLY_PROGRESS' &&
        (
          !('reviewStatus' in incoming()) ||
          incoming().reviewStatus == 'DRAFT' ||
          incoming().reviewStatus == 'SUBMITTED' ||
          (
            incoming().reviewStatus in ['APPROVED', 'REVISION_REQUESTED'] &&
            (isAdmin() || userRole() in ['HEAD_UNIT', 'HEAD_JUNIOR', 'PRINCIPAL', 'VICE_PRINCIPAL'])
          )
        );
    }

    match /manual_junior_high_report_links/{linkId} {
      allow get, list: if isActive() && (isJuniorHighStaff() || isAdmin());
      allow write: if isActive() && (isJuniorHighStaff() || isAdmin());
      allow get, list: if isActive() && isOwnStudentData(resource.data.studentId) && resource.data.status == 'PUBLISHED';
    }

    match /jh_other_report_links/{linkId} {
      allow get, list: if isActive() && (isJuniorHighStaff() || isJuniorHighStaffAuthorized() || isAdmin());
      allow write: if isActive() && (isJuniorHighStaff() || isJuniorHighStaffAuthorized() || isAdmin());
      allow get, list: if isActive() && isOwnStudentData(resource.data.studentId) && resource.data.status == 'PUBLISHED';
      allow update: if isActive() && (
        isOwnStudentData(resource.data.studentId) &&
        resource.data.status == 'PUBLISHED' &&
        request.resource.data.studentId == resource.data.studentId &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'isOpened', 'firstOpenedAt', 'lastOpenedAt', 'openCount', 'openedByEmail'
        ])
      );
    }

    match /elem_other_report_links/{linkId} {
      allow get, list: if isActive() && (isElementaryStaff() || isAdmin());
      allow write: if isActive() && (isElementaryStaff() || isAdmin());
      allow get, list: if isActive() && (isOwnStudentData(resource.data.studentId) || isLinkedStudent(resource.data.studentId)) && resource.data.status == 'PUBLISHED';
      allow update: if isActive() && (isOwnStudentData(resource.data.studentId) || isLinkedStudent(resource.data.studentId)) && (
        resource.data.status == 'PUBLISHED' &&
        request.resource.data.studentId == resource.data.studentId &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'isOpened', 'firstOpenedAt', 'lastOpenedAt', 'openCount', 'openedByEmail'
        ])
      );
    }

    match /monthlyReportViews/{viewId} {
      allow get, list: if isActive() && (isJuniorHighStaff() || isAdmin() || isOwnStudentData(resource.data.studentId));
      allow create: if isActive() && (
        isOwnStudentData(incoming().studentId) &&
        incoming().viewedAt == request.time &&
        incoming().viewerRole in ['student', 'parent'] &&
        incoming().reportId is string && incoming().reportId.size() <= 128 &&
        incoming().period is string && incoming().period.size() <= 32 &&
        get(/databases/$(database)/documents/manual_junior_high_report_links/$(incoming().reportId)).data.studentId == incoming().studentId
      );
      allow update, delete: if false;
    }

    match /junior_high_aap_results/{resultId} {
      allow list: if isActive() && (isJuniorHighStaff() || isAdmin());
      allow get: if isActive() && (
        (isJuniorHighStaff() || isAdmin()) ||
        ((isOwnStudentData(resource.data.studentId) || isLinkedStudent(resource.data.studentId)) && (resource.data.status == 'PUBLISHED' || resource.data.status == 'PERLU_PUBLISH_ULANG'))
      );
      allow create: if isActive() && (
        isAdmin() ||
        (
          isJuniorHighAAPTeacherForClass(request.resource.data.classId) &&
          get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.academicYear == request.resource.data.academicYear &&
          get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.status != 'archived' &&
          isStudentInClass(request.resource.data.studentId, request.resource.data.classId) &&
          request.resource.data.studentId != null && request.resource.data.studentId != "" &&
          request.resource.data.classId != null && request.resource.data.classId != "" &&
          request.resource.data.academicYear != null && request.resource.data.academicYear != "" &&
          (!('componentAudit' in request.resource.data) || (
            (!('numeracy' in request.resource.data.componentAudit) || request.resource.data.componentAudit.numeracy.updatedBy == request.auth.uid) &&
            (!('readingFluency' in request.resource.data.componentAudit) || request.resource.data.componentAudit.readingFluency.updatedBy == request.auth.uid) &&
            (!('mengaji' in request.resource.data.componentAudit) || request.resource.data.componentAudit.mengaji.updatedBy == request.auth.uid)
          ))
        )
      );
      allow update: if isActive() && (
        isAdmin() ||
        (
          isJuniorHighAAPTeacherForClass(request.resource.data.classId) &&
          get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.academicYear == request.resource.data.academicYear &&
          get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.status != 'archived' &&
          isStudentInClass(request.resource.data.studentId, request.resource.data.classId) &&
          request.resource.data.studentId != null && request.resource.data.studentId != "" &&
          request.resource.data.classId != null && request.resource.data.classId != "" &&
          request.resource.data.academicYear != null && request.resource.data.academicYear != "" &&
          request.resource.data.studentId == existing().studentId &&
          (!('componentAudit' in request.resource.data) || (
            (!('numeracy' in request.resource.data.componentAudit) || request.resource.data.componentAudit.numeracy.updatedBy == request.auth.uid) &&
            (!('readingFluency' in request.resource.data.componentAudit) || request.resource.data.componentAudit.readingFluency.updatedBy == request.auth.uid) &&
            (!('mengaji' in request.resource.data.componentAudit) || request.resource.data.componentAudit.mengaji.updatedBy == request.auth.uid)
          ))
        )
      );
      allow delete: if isActive() && (
        isAdmin() ||
        (
          isJuniorHighAAPTeacherForClass(resource.data.classId)
        )
      );
    }

    match /incidentReports/{reportId} {
      allow read: if isActive() && (
        isAdmin() ||
        isJuniorHighStaff() ||
        userRole() in ['PRINCIPAL', 'HEAD_UNIT', 'HEAD_JUNIOR', 'SUPER_ADMIN', 'VICE_PRINCIPAL', 'ADMIN', 'TEACHER', 'HOMEROOM_TEACHER']
      );

      allow create: if isActive() && (
        isAdmin() ||
        isJuniorHighStaff() ||
        userRole() in ['PRINCIPAL', 'HEAD_UNIT', 'HEAD_JUNIOR', 'SUPER_ADMIN', 'VICE_PRINCIPAL', 'ADMIN', 'TEACHER', 'HOMEROOM_TEACHER']
      );

      allow update: if isActive() && (
        isAdmin() ||
        userRole() in ['PRINCIPAL', 'HEAD_UNIT', 'HEAD_JUNIOR', 'SUPER_ADMIN', 'VICE_PRINCIPAL', 'ADMIN'] ||
        currentUser().role in ['HEAD_UNIT', 'PRINCIPAL', 'HEAD_JUNIOR', 'SUPER_ADMIN', 'VICE_PRINCIPAL', 'ADMIN'] ||
        (
          (isTeacher() || isJuniorHighStaff()) &&
          existing().status == 'DRAFT' &&
          incoming().status in ['DRAFT', 'MENUNGGU_APPROVAL']
        )
      );

      allow delete: if isActive() && (
        isAdmin() ||
        userRole() in ['PRINCIPAL', 'HEAD_UNIT', 'HEAD_JUNIOR', 'SUPER_ADMIN', 'VICE_PRINCIPAL', 'ADMIN'] ||
        currentUser().role in ['HEAD_UNIT', 'PRINCIPAL', 'HEAD_JUNIOR', 'SUPER_ADMIN', 'VICE_PRINCIPAL', 'ADMIN'] ||
        (
          (isTeacher() || isJuniorHighStaff()) &&
          existing().status == 'DRAFT'
        )
      );
    }

    // =========================================================================
    // JUNIOR HIGH SCHOOL ORGANIZATIONS (OSIS, SWJ, COMPETITIONS)
    // =========================================================================
    match /jh_so_configs/{configId} {
  allow read: if isSignedIn() && (
    isAdmin() ||
    isJuniorHighStaff() ||
    isStudent()
  );
  allow create, update: if isActive() && (
    isAdmin() ||
    (userRole() in ['HEAD_UNIT', 'HEAD_JUNIOR'] && isJuniorHighStaffAuthorized())
  );
  allow delete: if isActive() && isAdmin();
}

    match /jh_so_groups/{groupId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isJuniorHighStaff() ||
        isStudent()
      );
      allow create, update: if isActive() && (
        isAdmin() ||
        (userRole() in ['HEAD_UNIT', 'HEAD_JUNIOR'] && isJuniorHighStaffAuthorized()) ||
        isJuniorHighTeacher()
      );
      allow delete: if isActive() && (
        isAdmin() ||
        (userRole() in ['HEAD_UNIT', 'HEAD_JUNIOR'] && isJuniorHighStaffAuthorized())
      );
    }

    match /jh_so_memberships/{membershipId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isJuniorHighStaff() ||
        (isStudent() && resource != null && (
          isOwnStudentData(resource.data.studentId) ||
          exists(/databases/$(database)/documents/jh_so_memberships/$(resource.data.groupId + '_' + getStudentNis()))
        ))
      );
      allow create, update, delete: if isActive() && (
        isAdmin() ||
        (userRole() in ['HEAD_UNIT', 'HEAD_JUNIOR'] && isJuniorHighStaffAuthorized()) ||
        isJuniorHighTeacher()
      );
    }

    match /jh_so_weekly_reports/{reportId} {
      allow get: if isSignedIn() && (
        isAdmin() ||
        isJuniorHighStaff() ||
        (isStudent() && (
          resource == null ||
          isOwnStudentData(resource.data.studentId) ||
          (
            exists(/databases/$(database)/documents/jh_so_memberships/$(resource.data.groupId + '_' + getStudentNis())) &&
            get(/databases/$(database)/documents/jh_so_memberships/$(resource.data.groupId + '_' + getStudentNis())).data.canAssignTasks == true
          )
        ))
      );

      allow list: if isSignedIn() && (
        isAdmin() ||
        isJuniorHighStaff() ||
        (isStudent() && resource != null && (
          isOwnStudentData(resource.data.studentId) ||
          (
            exists(/databases/$(database)/documents/jh_so_memberships/$(resource.data.groupId + '_' + getStudentNis())) &&
            get(/databases/$(database)/documents/jh_so_memberships/$(resource.data.groupId + '_' + getStudentNis())).data.canAssignTasks == true
          )
        ))
      );

      allow create: if isActive() && isStudent() &&
        isOwnStudentData(incoming().studentId) &&
        reportId == (incoming().groupId + '_' + incoming().studentId + '_' + incoming().weekStart) &&
        exists(/databases/$(database)/documents/jh_so_memberships/$(incoming().groupId + '_' + incoming().studentId)) &&
        incoming().status in ['DRAFT', 'SUBMITTED'] &&
        incoming().doneText is string && incoming().doneText.size() <= 1500 &&
        incoming().nextText is string && incoming().nextText.size() <= 1500 &&
        (!('feedbackText' in incoming()) || incoming().feedbackText == null) &&
        (!('readAt' in incoming()) || incoming().readAt == null);

      allow update: if isActive() && (
        (
          isStudent() &&
          isOwnStudentData(existing().studentId) &&
          (!('readAt' in existing()) || existing().readAt == null || existing().readAt == '') &&
          incoming().diff(existing()).affectedKeys().hasOnly(['doneText', 'nextText', 'status', 'submittedAt', 'isLate', 'updatedAt']) &&
          incoming().status in ['DRAFT', 'SUBMITTED'] &&
          incoming().doneText is string && incoming().doneText.size() <= 1500 &&
          incoming().nextText is string && incoming().nextText.size() <= 1500
        ) ||
        (
          (isAdmin() || (userRole() in ['HEAD_UNIT', 'HEAD_JUNIOR'] && isJuniorHighStaffAuthorized()) || isJuniorHighTeacher()) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['feedbackText', 'feedbackBy', 'feedbackByName', 'feedbackAt', 'readAt', 'readBy', 'readByName', 'updatedAt']) &&
          (!('feedbackText' in incoming()) || incoming().feedbackText == null || (incoming().feedbackText is string && incoming().feedbackText.size() <= 300))
        )
      );

      allow delete: if isActive() && isAdmin();
    }
    // === SAHABAT QUR'AN (ELEMENTARY) ===
    function isQuranElementaryStaff() {
      return isActive() && (
        isAdmin() || (
          userRole() in ['TEACHER', 'HOMEROOM_TEACHER', 'HEAD_UNIT', 'PRINCIPAL', 'VICE_PRINCIPAL', 'COORDINATOR', 'SECRETARY_ELEM'] && (
            ('unitId' in currentUser() && currentUser().unitId in ['ELEMENTARY', 'ALL']) ||
            ('unit' in currentUser() && currentUser().unit in ['ELEMENTARY', 'ALL']) ||
            ('units' in currentUser() && currentUser().units is list && currentUser().units.hasAny(['ELEMENTARY', 'ALL']))
          )
        )
      );
    }

    function isQuranParticipantActive(studentId) {
      return studentId is string &&
        exists(/databases/$(database)/documents/elementary_quran_participants/$(studentId)) &&
        get(/databases/$(database)/documents/elementary_quran_participants/$(studentId)).data.status == 'active';
    }

    function isValidQuranLogData(data) {
      return data.juz is int && data.juz >= 1 && data.juz <= 30 &&
        data.surahNumber is int && data.surahNumber >= 1 && data.surahNumber <= 114 &&
        data.ayat is int && data.ayat >= 1 &&
        data.readDate is string && data.readDate.size() == 10 &&
        (!('note' in data) || (data.note is string && data.note.size() <= 200));
    }

    match /elementary_quran_participants/{studentId} {
      allow read: if isSignedIn() && (isQuranElementaryStaff() || isOwnStudentData(studentId));
      allow create: if isQuranElementaryStaff() &&
        incoming().keys().hasAll(['studentUid', 'studentName', 'unit', 'status', 'registeredByUid', 'registeredAt', 'updatedByUid', 'updatedAt']) &&
        incoming().studentUid == studentId &&
        incoming().studentName is string &&
        incoming().unit == 'ELEMENTARY' &&
        incoming().status == 'active' &&
        incoming().registeredByUid == request.auth.uid &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().registeredAt is timestamp &&
        incoming().updatedAt is timestamp;
      allow update: if isQuranElementaryStaff() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedByUid', 'updatedAt']) &&
        incoming().status in ['active', 'inactive'] &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt is timestamp;
      allow delete: if isAdmin();
    }

    match /elementary_quran_reading_logs/{logId} {
      allow read: if isSignedIn() && (isQuranElementaryStaff() || isOwnStudentData(resource.data.studentUid));
      allow create: if isActive() &&
        isOwnStudentData(incoming().studentUid) &&
        isQuranParticipantActive(incoming().studentUid) &&
        incoming().unit == 'ELEMENTARY' &&
        incoming().source == 'app' &&
        incoming().editCount == 0 &&
        incoming().createdAt is timestamp &&
        isValidQuranLogData(incoming());
      allow update: if isActive() &&
        isOwnStudentData(existing().studentUid) &&
        isQuranParticipantActive(existing().studentUid) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['readDate', 'juz', 'surahNumber', 'surahName', 'ayat', 'note', 'updatedAt', 'editCount']) &&
        incoming().editCount == existing().editCount + 1 &&
        incoming().updatedAt is timestamp &&
        isValidQuranLogData(incoming());
      allow delete: if isAdmin() || (
        isActive() &&
        isOwnStudentData(resource.data.studentUid) &&
        isQuranParticipantActive(resource.data.studentUid)
      );

      match /history/{historyId} {
        allow read: if isSignedIn() && (
          isQuranElementaryStaff() ||
          isOwnStudentData(get(/databases/$(database)/documents/elementary_quran_reading_logs/$(logId)).data.studentUid)
        );
        allow create: if isActive() &&
          isOwnStudentData(get(/databases/$(database)/documents/elementary_quran_reading_logs/$(logId)).data.studentUid) &&
          isQuranParticipantActive(get(/databases/$(database)/documents/elementary_quran_reading_logs/$(logId)).data.studentUid) &&
          incoming().changedByUid == request.auth.uid &&
          incoming().changedAt is timestamp;
        allow update, delete: if false;
      }
    }

    // === INFORMASI SEKOLAH (ELEMENTARY) ===
    function isElemSchoolInfoStaff() {
      return isActive() && (
        isAdmin() || (
          userRole() in ['TEACHER', 'HOMEROOM_TEACHER', 'HEAD_UNIT', 'PRINCIPAL', 'VICE_PRINCIPAL', 'COORDINATOR', 'SECRETARY_ELEM', 'BK_MENTOR'] && (
            ('unitId' in currentUser() && currentUser().unitId in ['ELEMENTARY', 'ALL']) ||
            ('unit' in currentUser() && currentUser().unit in ['ELEMENTARY', 'ALL']) ||
            ('units' in currentUser() && currentUser().units is list && currentUser().units.hasAny(['ELEMENTARY', 'ALL']))
          )
        )
      );
    }

    function isElemSchoolInfoHeadOrAdmin() {
      return isActive() && (
        isAdmin() || (
          userRole() in ['HEAD_UNIT', 'PRINCIPAL'] && (
            ('unitId' in currentUser() && currentUser().unitId in ['ELEMENTARY', 'ALL']) ||
            ('unit' in currentUser() && currentUser().unit in ['ELEMENTARY', 'ALL']) ||
            ('units' in currentUser() && currentUser().units is list && currentUser().units.hasAny(['ELEMENTARY', 'ALL']))
          )
        )
      );
    }

    match /elementary_school_information/{infoId} {
      allow read: if isSignedIn() && (
        isElemSchoolInfoStaff() ||
        (resource.data.status == 'PUBLISHED' && resource.data.unit == 'ELEMENTARY')
      );
      allow create: if isElemSchoolInfoStaff() &&
        incoming().authorUid == request.auth.uid &&
        incoming().unit == 'ELEMENTARY' &&
        incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 300 &&
        incoming().category is string &&
        incoming().status in ['DRAFT', 'PUBLISHED', 'ARCHIVED'] &&
        (
          (incoming().hasPdf == true && ('pdfAttachment' in incoming()) && incoming().pdfAttachment != null) ||
          (('content' in incoming()) && incoming().content is string && incoming().content.size() > 0)
        );
      allow update: if (isElemSchoolInfoHeadOrAdmin() || (isElemSchoolInfoStaff() && existing().authorUid == request.auth.uid)) &&
        incoming().unit == 'ELEMENTARY' &&
        incoming().authorUid == existing().authorUid &&
        incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 300 &&
        incoming().status in ['DRAFT', 'PUBLISHED', 'ARCHIVED'] &&
        (
          (incoming().hasPdf == true && ('pdfAttachment' in incoming()) && incoming().pdfAttachment != null) ||
          (('content' in incoming()) && incoming().content is string && incoming().content.size() > 0)
        );
      allow delete: if isElemSchoolInfoHeadOrAdmin() || (isElemSchoolInfoStaff() && existing().authorUid == request.auth.uid);
    }
  }
}